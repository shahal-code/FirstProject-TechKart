<!DOCTYPE html>
<html class="dark" lang="en">

<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>TechKart Admin - Category Management</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&display=swap"
        rel="stylesheet" />
    <link
        href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap"
        rel="stylesheet" />
    <script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        "primary": "#0055ff",
                        "background-light": "#f5f6f8",
                        "background-dark": "#0a0c10",
                        "card-bg": "rgba(23, 33, 54, 0.4)",
                    },
                    fontFamily: {
                        "display": ["Space Grotesk", "sans-serif"]
                    },
                    borderRadius: {
                        "DEFAULT": "0.5rem",
                        "lg": "1rem",
                        "xl": "1.5rem",
                        "full": "9999px"
                    },
                },
            },
        }
    </script>
    <style>
        body {
            font-family: 'Space Grotesk', sans-serif;
            background-color: #0a0c10;
            color: white;
            -webkit-font-smoothing: antialiased;
            -moz-osx-font-smoothing: grayscale;
        }
        .input-field {
            width: 100%;
            background-color: rgba(255, 255, 255, 0.05);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 0.5rem;
            padding: 0.625rem 1rem;
            font-size: 0.875rem;
            color: #e2e8f0;
            transition: all 0.3s ease;
            outline: none;
        }
        .input-field:focus {
            box-shadow: 0 0 0 1px #0055ff;
            border-color: #0055ff;
        }
        .input-field::placeholder {
            color: #64748b;
        }
        .custom-scrollbar::-webkit-scrollbar {
            width: 4px;
            height: 4px;
        }
        .custom-scrollbar::-webkit-scrollbar-track {
            background: transparent;
        }
        .custom-scrollbar::-webkit-scrollbar-thumb {
            background: rgba(255, 255, 255, 0.1);
            border-radius: 10px;
        }
        .status-badge {
            padding: 0.25rem 0.75rem;
            border-radius: 9999px;
            font-size: 10px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            display: inline-flex;
            align-items: center;
        }
        .status-active { background-color: rgba(0, 85, 255, 0.1); color: #0055ff; border: 1px solid rgba(0, 85, 255, 0.3); }
        .status-blocked { background-color: rgba(244, 63, 94, 0.1); color: #f43f5e; border: 1px solid rgba(244, 63, 94, 0.2); }
    </style>
</head>

<body class="flex min-h-screen">
    <!-- Sidebar -->
    <%- include('../partials/admin/sidebar') %>

    <main class="flex-1 flex flex-col relative overflow-y-auto custom-scrollbar min-w-0">
        <!-- Header -->
        <%- include('../partials/admin/header') %>

        <div class="p-4 md:p-10 max-w-[1600px] mx-auto w-full space-y-6 md:space-y-8">
            
            <!-- Page Header (Categories, Search, Add Btn) -->
            <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
                <div>
                    <h1 class="text-3xl font-bold">Categories</h1>
                    <p class="text-slate-400 text-sm mt-1">Organize and manage your catalog</p>
                </div>
                
                <div class="flex flex-1 max-w-lg w-full items-center gap-4">
                    <!-- Search Form -->
                    <form action="/admin/category" method="GET" class="relative flex-1">
                        <span class="material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2 text-slate-500 text-xl">search</span>
                        <input class="input-field pl-12 h-12 w-full bg-[#111827]/50 rounded-full" name="search" value="<%= typeof search !== 'undefined' ? search : '' %>"
                            placeholder="Search categories..." type="text" />
                        <% if (typeof search !== 'undefined' && search) { %>
                            <button type="button" onclick="window.location.href='/admin/category'"
                                class="absolute right-4 top-1/2 -translate-y-1/2 text-slate-500 hover:text-white transition-all">
                                <span class="material-symbols-outlined text-lg">close</span>
                            </button>
                        <% } %>
                    </form>
                    
                    <button onclick="openAddCategoryModal()" class="bg-primary hover:bg-primary/80 text-white font-bold px-6 h-12 rounded-full transition-all tracking-wide flex items-center gap-2 flex-shrink-0">
                        <span class="material-symbols-outlined text-sm">add</span> Add Category
                    </button>
                </div>
            </div>

            <!-- Stats Cards -->
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                <!-- Total Categories -->
                <div class="bg-[#111827]/50 rounded-2xl p-6 border border-white/5 relative overflow-hidden">
                    <p class="text-[10px] font-bold text-slate-400 uppercase tracking-widest mb-2">Total Categories</p>
                    <div class="mt-4">
                        <h3 class="text-4xl font-bold"><%= typeof stats !== 'undefined' ? stats.total : 0 %></h3>
                        <p class="text-xs text-slate-500 mt-2"><span class="text-emerald-500 font-medium">+<%= typeof stats !== 'undefined' ? stats.addedQuarter : 0 %></span> added this quarter</p>
                    </div>
                </div>

                <!-- Most Popular -->
                <div class="bg-[#111827]/50 rounded-2xl p-6 border border-white/5">
                    <p class="text-[10px] font-bold text-slate-400 uppercase tracking-widest mb-2">Most Popular</p>
                    <div class="mt-4">
                        <h3 class="text-2xl font-bold">Gaming Laptops</h3>
                        <p class="text-xs text-slate-500 mt-2"><span class="text-primary font-medium">45%</span> of total sales</p>
                    </div>
                </div>

                <!-- Newest Category -->
                <div class="bg-[#111827]/50 rounded-2xl p-6 border border-white/5">
                    <p class="text-[10px] font-bold text-slate-400 uppercase tracking-widest mb-2">Newest Category</p>
                    <div class="mt-4 flex flex-col justify-end">
                        <h3 class="text-2xl font-bold truncate"><%= typeof stats !== 'undefined' ? stats.newestName : 'N/A' %></h3>
                        <p class="text-xs text-slate-500 mt-2">
                        <% if(typeof stats !== 'undefined' && stats.newestDate) { %>
                            <% const daysAgo = Math.floor((new Date() - new Date(stats.newestDate)) / (1000 * 60 * 60 * 24)); %>
                            Added <%= daysAgo === 0 ? "today" : daysAgo + " days ago" %>
                        <% } else { %>
                            No data
                        <% } %>
                        </p>
                    </div>
                </div>
            </div>

            <!-- Categories Table -->
            <div class="bg-[#111827]/50 rounded-3xl overflow-x-auto border border-white/5 custom-scrollbar">
                <table class="w-full text-left border-collapse">
                    <thead>
                        <tr class="bg-white/5 border-b border-white/5">
                            <th class="px-8 py-5 text-[10px] font-bold text-slate-400 uppercase tracking-widest">Category Name</th>
                            <th class="px-6 py-5 text-[10px] font-bold text-slate-400 uppercase tracking-widest text-center">Number of Products</th>
                            <th class="px-6 py-5 text-[10px] font-bold text-slate-400 uppercase tracking-widest">Status</th>
                            <th class="px-8 py-5 text-[10px] font-bold text-slate-400 uppercase tracking-widest text-right">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-white/5">
                        <% if (typeof categories !== 'undefined' && categories && categories.length > 0) { %>
                            <% categories.forEach(category => { %>
                                <tr class="hover:bg-white/5 transition-colors group">
                                    <td class="px-8 py-6">
                                        <div class="flex items-center gap-4">
                                            <div class="h-12 w-12 rounded-full bg-primary/20 border border-primary/30 flex items-center justify-center text-primary">
                                                <span class="material-symbols-outlined text-[20px]"><%= category.icon || 'category' %></span>
                                            </div>
                                            <div>
                                                <p class="text-sm font-bold text-slate-100"><%= category.name %></p>
                                                <p class="text-xs text-slate-500 font-medium"><%= category.description %></p>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="px-6 py-5 text-center">
                                        <p class="text-sm font-bold text-slate-100">0</p>
                                    </td>
                                    <td class="px-6 py-5">
                                        <span class="status-badge <%= !category.is_blocked ? 'status-active' : 'status-blocked' %>">
                                            <%= !category.is_blocked ? 'Active' : 'Blocked' %>
                                        </span>
                                    </td>
                                    <td class="px-8 py-5 text-right">
                                        <div class="flex items-center justify-end gap-3">
                                            <button onclick="editCategory('<%= category._id %>', '<%= category.name %>', '<%= category.description %>', '<%= category.icon %>')" class="text-[10px] font-bold uppercase tracking-widest text-emerald-500 hover:text-emerald-400 transition-all border border-emerald-500/30 px-3 py-1.5 rounded-full hover:bg-emerald-500/10">
                                                Edit
                                            </button>
                                            <button onclick="toggleList('<%= category._id %>', '<%= category.is_blocked %>')" class="text-[10px] font-bold uppercase tracking-widest text-rose-500 hover:text-rose-400 transition-all border border-rose-500/30 px-3 py-1.5 rounded-full hover:bg-rose-500/10">
                                                <%= !category.is_blocked ? 'Block' : 'Unblock' %>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            <% }) %>
                        <% } else { %>
                            <tr>
                                <td colspan="4" class="px-8 py-10 text-center text-slate-500 italic">No categories found.</td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>

            <!-- Pagination -->
            <div class="flex items-center justify-between">
                <p class="text-xs text-slate-500 font-medium">
                    Showing categories
                </p>
                <% if (typeof totalPages !== 'undefined' && totalPages > 1) { %>
                    <div class="flex items-center gap-2">
                        <a href="?page=<%= page - 1 %>&search=<%= search %>"
                            class="px-5 py-2 rounded-full border border-white/10 text-slate-400 hover:bg-white/5 transition-all text-xs font-medium <%= page === 1 ? 'pointer-events-none opacity-30' : '' %>">
                            Previous
                        </a>
                        <!-- ... pagination numbers ... -->
                        <a href="?page=<%= page + 1 %>&search=<%= search %>"
                            class="px-5 py-2 rounded-full border border-white/10 text-slate-400 hover:bg-white/5 transition-all text-xs font-medium <%= page === totalPages ? 'pointer-events-none opacity-30' : '' %>">
                            Next
                        </a>
                    </div>
                <% } %>
            </div>
        </div>
    </main>

    <!-- Modal -->
    <div id="addCategoryModal" class="fixed inset-0 z-50 flex items-center justify-center bg-black/60 backdrop-blur-sm hidden opacity-0 transition-opacity duration-300">
        <div class="bg-[#0a0c10] border border-white/10 w-full max-w-lg rounded-2xl shadow-2xl overflow-hidden transform scale-95 transition-transform duration-300">
            <div class="p-6 border-b border-white/5 flex justify-between items-center bg-[#111827]/50">
                <h3 class="text-xl font-bold" id="modalTitle">Add New Category</h3>
                <button onclick="closeModal()" class="text-slate-400 hover:text-white transition-colors">
                    <span class="material-symbols-outlined">close</span>
                </button>
            </div>
            <div class="p-6">
                <form id="categoryForm">
                    <div class="space-y-4">
                        <div>
                            <label class="text-[10px] font-bold text-slate-400 uppercase tracking-widest mb-2 block">Category Name</label>
                            <input type="text" id="categoryName" name="name" required class="input-field" placeholder="e.g. Gaming Laptops" />
                        </div>
                        <div>
                            <label class="text-[10px] font-bold text-slate-400 uppercase tracking-widest mb-2 block">Description</label>
                            <textarea id="categoryDescription" name="description" required class="input-field resize-none h-24" placeholder="Brief description..."></textarea>
                        </div>
                    </div>
                    <div class="mt-8 flex justify-end gap-3">
                        <button type="button" onclick="closeModal()" class="px-6 py-2.5 rounded-lg border border-white/10 text-slate-300 hover:bg-white/5 transition-colors font-medium text-sm">Cancel</button>
                        <button type="submit" class="px-6 py-2.5 rounded-lg bg-primary hover:bg-primary/80 text-white font-medium shadow-[0_0_20px_rgba(0,85,255,0.3)] transition-colors text-sm">Save Category</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <script src="/js/admin/category.js"></script>
</body>
</html>
