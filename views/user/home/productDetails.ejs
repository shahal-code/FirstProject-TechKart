<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= product.name %> | TechKart</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0" />
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Outfit:wght@100;300;400;500;700;900&display=swap');
        
        body { font-family: 'Outfit', sans-serif; background-color: #050505; color: #fff; }
        .premium-heading { letter-spacing: -0.02em; }
        .glass-card { background: rgba(255, 255, 255, 0.03); backdrop-filter: blur(20px); border: 1px solid rgba(255, 255, 255, 0.08); }
        .bg-primary { background-color: #3b82f6; } /* Tailwind blue-500 */
        .text-primary { color: #3b82f6; }
    </style>
</head>
<body class="min-h-screen">
    <%- include('../../partials/user/header') %>

    <main class="container mx-auto px-6 py-20 mt-10">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-20">
            <!-- Left: Gallery -->
            <div class="space-y-8">
                <div class="glass-card aspect-[4/3] rounded-3xl overflow-hidden relative">
                    <img id="mainImage" src="<%= product.images[0] %>" class="w-full h-full object-cover" />
                </div>
                <div class="grid grid-cols-4 gap-6">
                    <% product.images.forEach((img, index) => { %>
                        <div class="glass-card aspect-square rounded-2xl overflow-hidden cursor-pointer hover:border-primary transition-all duration-300 thumbnails border-2 <%= index === 0 ? 'border-primary' : 'border-transparent' %>" 
                             onclick="changeImage('<%= img %>', this)">
                            <img src="<%= img %>" class="w-full h-full object-cover" />
                        </div>
                    <% }) %>
                </div>
            </div>

            <!-- Right: Info -->
            <div class="space-y-10">
                <div class="space-y-4">
                    <h1 class="text-5xl font-black premium-heading uppercase tracking-tight"><%= product.name %></h1>
                    <div class="flex items-center gap-6">
                        <span class="text-4xl font-bold text-primary">$<%= product.variants[0].price %></span>
                    </div>
                </div>

                <!-- Badges -->
                <div class="flex flex-wrap gap-3">
                    <div class="px-4 py-2 bg-white/5 border border-white/10 rounded-lg text-[10px] font-bold uppercase tracking-widest flex items-center gap-2">
                        <span class="material-symbols-outlined text-sm">memory</span>
                        <%= product.variants[0].processor %>
                    </div>
                    <div class="px-4 py-2 bg-white/5 border border-white/10 rounded-lg text-[10px] font-bold uppercase tracking-widest flex items-center gap-2">
                        <span class="material-symbols-outlined text-sm">developer_board</span>
                        <%= product.variants[0].ram %> DDR5
                    </div>
                    <div class="px-4 py-2 bg-white/5 border border-white/10 rounded-lg text-[10px] font-bold uppercase tracking-widest flex items-center gap-2">
                        <span class="material-symbols-outlined text-sm">database</span>
                        <%= product.variants[0].storage %> NVMe SSD
                    </div>
                </div>

                <p class="text-gray-400 leading-relaxed text-lg max-w-xl">
                    <%= product.description %>
                </p>

                <!-- Selectors -->
                <div class="space-y-8">
                    <!-- Variant options would go here dynamic -->
                </div>

                <div class="space-y-4 pt-6">
                    <button class="w-full py-5 bg-primary text-white font-black uppercase tracking-[0.2em] rounded-2xl hover:bg-blue-600 transition-all shadow-[0_0_30px_rgba(59,130,246,0.3)]">
                        Add to Cart
                    </button>
                    <button class="w-full py-5 border border-white/20 text-white font-black uppercase tracking-[0.2em] rounded-2xl hover:bg-white/5 transition-all">
                        Buy Now
                    </button>
                </div>
            </div>
        </div>
    </main>

    <%- include('../../partials/user/footer') %>

    <script>
        function changeImage(src, thumb) {
            document.getElementById('mainImage').src = src;
            document.querySelectorAll('.thumbnails').forEach(t => t.classList.remove('border-primary', 'border-transparent'));
            document.querySelectorAll('.thumbnails').forEach(t => t.classList.add('border-transparent'));
            thumb.classList.add('border-primary');
            thumb.classList.remove('border-transparent');
        }
    </script>
</body>
</html>
