                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
            <div class="glass-morphism high-gloss rounded-2xl overflow-hidden flex flex-col min-h-[520px]">
              <div class="p-6 border-b border-white/5 flex items-center justify-between bg-white/5">
                <div>
