<!DOCTYPE html>
<html class="dark" lang="en">
<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>TechKart Admin - Product Inventory</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
    <script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        "primary": "#0055ff",
                        "background-dark": "#0d0d0d",
                    },
                    fontFamily: {
                        "display": ["Space Grotesk", "sans-serif"]
                    },
                },
            },
        }
    </script>
    <style type="text/tailwindcss">
        body {
            font-family: 'Space Grotesk', sans-serif;
            @apply bg-background-dark text-white;
        }
        .glass-morphism {
            background: rgba(23, 33, 54, 0.6);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border: 1px solid rgba(255, 255, 255, 0.08);
        }
        .stat-card {
            @apply glass-morphism rounded-xl p-6 relative overflow-hidden;
        }
        .custom-scrollbar::-webkit-scrollbar {
            width: 4px;
        }
        .custom-scrollbar::-webkit-scrollbar-track {
            background: transparent;
        }
        .custom-scrollbar::-webkit-scrollbar-thumb {
            background: rgba(255, 255, 255, 0.1);
            border-radius: 10px;
        }
        .input-field {
            @apply bg-[#151923] border border-white/5 rounded-xl py-3 px-4 text-sm focus:outline-none focus:ring-1 focus:ring-primary focus:border-primary transition-all placeholder:text-slate-600;
        }
        .filter-select {
            @apply bg-transparent text-sm text-slate-300 font-medium py-2 pr-8 focus:outline-none focus:ring-0 border-none appearance-none cursor-pointer;
        }
    </style>
</head>

<body class="flex min-h-screen bg-[#0D0D0D]">
    <%- include('../../partials/admin/sidebar') %>

    <main class="flex-1 flex flex-col relative overflow-y-auto custom-scrollbar">
        <%- include('../../partials/admin/header') %>

        <div class="p-8 lg:p-12 space-y-8">
            <!-- Header Area -->
            <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
                <div>
                    <h2 class="text-3xl font-bold tracking-tight mb-1">Product Inventory</h2>
                    <p class="text-sm text-slate-500 font-medium">Manage your hardware catalog</p>
                </div>
                <button onclick="window.location.href='/admin/addProduct'"
                    class="flex items-center gap-2 bg-primary hover:bg-primary/90 text-white px-6 py-3 rounded-full font-bold text-sm tracking-wide transition-all shadow-[0_4px_20px_rgba(0,85,255,0.4)]">
                    <span class="material-symbols-outlined text-sm">add</span>
                    ADD NEW PRODUCT
                </button>
            </div>

            <!-- Stats grid -->
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                <!-- Stat 1 -->
                <div class="stat-card">
                    <div class="flex justify-between items-start mb-6">
                        <p class="text-xs font-bold text-slate-400">Total Products</p>
                        <span class="material-symbols-outlined text-primary text-xl">inventory_2</span>
                    </div>
                    <div class="flex items-end gap-3">
                        <h3 class="text-4xl font-bold tracking-tight">1,284</h3>
                        <span class="text-emerald-400 text-sm font-bold mb-1">+14 new</span>
                    </div>
                </div>
                <!-- Stat 2 -->
                <div class="stat-card">
                    <div class="flex justify-between items-start mb-6">
                        <p class="text-xs font-bold text-slate-400">Low Stock Items</p>
                        <span class="material-symbols-outlined text-amber-500 text-xl">warning</span>
                    </div>
                    <div class="flex items-end gap-3">
                        <h3 class="text-4xl font-bold tracking-tight text-white">28</h3>
                    </div>
                    <p class="text-xs text-slate-500 mt-2">Requires immediate attention</p>
                </div>
                <!-- Stat 3 -->
                <div class="stat-card">
                    <div class="flex justify-between items-start mb-6">
                        <p class="text-xs font-bold text-slate-400">Out of Stock</p>
                        <span class="text-rose-500 text-xs font-bold tracking-wider uppercase">Block</span>
                    </div>
                    <div class="flex items-end gap-3">
                        <h3 class="text-4xl font-bold tracking-tight text-white">06</h3>
                    </div>
                    <p class="text-xs text-slate-500 mt-2">Inactive in storefront</p>
                </div>
            </div>

            <!-- Table Section -->
            <section class="glass-morphism rounded-2xl overflow-hidden border border-white/5">
                <!-- Filters -->
                <div class="p-6 border-b border-white/5 flex flex-wrap items-center justify-between gap-4">
                    <div class="flex items-center gap-6">
                        <div class="relative flex items-center">
                            <select class="filter-select">
                                <option>Category</option>
                                <option>Gaming</option>
                                <option>Ultrabook</option>
                            </select>
                            <span class="material-symbols-outlined absolute right-0 pointer-events-none text-slate-400 text-sm">expand_more</span>
                        </div>
                        <div class="relative flex items-center">
                            <select class="filter-select">
                                <option>Price Range</option>
                                <option>Under $1000</option>
                                <option>$1000 - $2000</option>
                            </select>
                            <span class="material-symbols-outlined absolute right-0 pointer-events-none text-slate-400 text-sm">expand_more</span>
                        </div>
                        <div class="relative flex items-center">
                            <select class="filter-select">
                                <option>Status</option>
                                <option>Active</option>
                                <option>Out of Stock</option>
                            </select>
                            <span class="material-symbols-outlined absolute right-0 pointer-events-none text-slate-400 text-sm">expand_more</span>
                        </div>
                        <button class="bg-primary text-white text-xs font-bold px-5 py-2 rounded-lg">Apply Filters</button>
                        <button class="text-slate-400 text-xs hover:text-white transition-colors">Reset Filters</button>
                    </div>

                    <div class="relative">
                        <input type="text" placeholder="Search" class="bg-white/5 border border-white/10 rounded-full py-2 pl-4 pr-10 text-sm w-64 focus:outline-none focus:border-primary text-white placeholder:text-slate-500">
                        <span class="material-symbols-outlined absolute right-4 top-1/2 -translate-y-1/2 text-slate-500 text-sm">search</span>
                    </div>
                </div>

                <!-- Table -->
                <div class="overflow-x-auto">
                    <table class="w-full text-left border-collapse">
                        <thead>
                            <tr class="border-b border-white/5 text-xs text-slate-500 font-medium">
                                <th class="px-6 py-4 font-medium">Image</th>
                                <th class="px-6 py-4 font-medium">Product Name</th>
                                <th class="px-6 py-4 font-medium">Category</th>
                                <th class="px-6 py-4 font-medium">Stock Level</th>
                                <th class="px-6 py-4 font-medium">Price</th>
                                <th class="px-6 py-4 font-medium text-right">Action</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-white/5 text-sm">
                            <!-- Example Row 1 -->
                            <tr class="hover:bg-white/[0.02] transition-colors group">
                                <td class="px-6 py-4">
                                    <div class="w-12 h-12 rounded-xl bg-[#151923] border border-white/5 flex items-center justify-center overflow-hidden">
                                        <!-- Placeholder image -->
                                        <div class="w-8 h-6 bg-gradient-to-r from-emerald-400 to-cyan-400 rounded-sm opacity-50"></div>
                                    </div>
                                </td>
                                <td class="px-6 py-4">
                                    <p class="font-bold text-white mb-1">TechKart Ultra X</p>
                                    <p class="text-[10px] text-slate-500 uppercase tracking-wider">SKU: TK-UX-2024</p>
                                </td>
                                <td class="px-6 py-4">
                                    <span class="px-3 py-1 rounded-full bg-primary/10 text-primary text-[10px] font-bold border border-primary/20">Ultrabook</span>
                                </td>
                                <td class="px-6 py-4">
                                    <div class="flex items-center gap-3">
                                        <div class="w-24 h-1.5 bg-white/10 rounded-full overflow-hidden">
                                            <div class="h-full bg-emerald-400 w-[85%]"></div>
                                        </div>
                                        <span class="text-xs text-slate-400">85%</span>
                                    </div>
                                </td>
                                <td class="px-6 py-4 font-bold">$2,499.00</td>
                                <td class="px-6 py-4 text-right">
                                    <button class="text-slate-500 hover:text-white transition-colors">
                                        <span class="material-symbols-outlined text-lg">more_horiz</span>
                                    </button>
                                </td>
                            </tr>
                            
                            <!-- Example Row 2 -->
                            <tr class="hover:bg-white/[0.02] transition-colors group">
                                <td class="px-6 py-4">
                                    <div class="w-12 h-12 rounded-xl bg-[#151923] border border-white/5 flex items-center justify-center overflow-hidden">
                                        <div class="w-8 h-8 bg-gradient-to-tr from-purple-500 to-rose-500 rounded-sm opacity-50"></div>
                                    </div>
                                </td>
                                <td class="px-6 py-4">
                                    <p class="font-bold text-white mb-1">Neon Blade 15</p>
                                    <p class="text-[10px] text-slate-500 uppercase tracking-wider">SKU: TK-NB-15</p>
                                </td>
                                <td class="px-6 py-4">
                                    <span class="px-3 py-1 rounded-full bg-purple-500/10 text-purple-400 text-[10px] font-bold border border-purple-500/20">Gaming</span>
                                </td>
                                <td class="px-6 py-4">
                                    <div class="flex items-center gap-3">
                                        <div class="w-24 h-1.5 bg-white/10 rounded-full overflow-hidden">
                                            <div class="h-full bg-amber-500 w-[12%]"></div>
                                        </div>
                                        <span class="text-xs text-slate-400">12%</span>
                                    </div>
                                </td>
                                <td class="px-6 py-4 font-bold">$1,899.50</td>
                                <td class="px-6 py-4 text-right">
                                    <button class="text-slate-500 hover:text-white transition-colors">
                                        <span class="material-symbols-outlined text-lg">more_horiz</span>
                                    </button>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>

                <!-- Pagination -->
                <div class="p-6 border-t border-white/5 flex items-center justify-between">
                    <p class="text-xs text-slate-500">Showing 1 to 4 of 1,284 products</p>
                    <div class="flex gap-2">
                        <button class="px-4 py-2 bg-white/5 rounded-lg text-xs font-medium text-slate-400 hover:bg-white/10 transition-colors border border-white/5">Previous</button>
                        <button class="w-8 h-8 flex items-center justify-center bg-primary rounded-lg text-xs font-bold text-white shadow-[0_2px_10px_rgba(0,85,255,0.3)]">1</button>
                        <button class="w-8 h-8 flex items-center justify-center bg-white/5 rounded-lg text-xs font-medium text-slate-400 hover:bg-white/10 transition-colors border border-white/5">2</button>
                        <button class="px-4 py-2 bg-white/5 rounded-lg text-xs font-medium text-slate-400 hover:bg-white/10 transition-colors border border-white/5">Next</button>
                    </div>
                </div>
            </section>
        </div>
    </main>
</body>
</html>
