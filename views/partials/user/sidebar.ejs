<aside class="w-72 h-full hidden lg:flex flex-col border-r border-white/10 bg-background-dark p-6">
    <div class="flex items-center gap-4 mb-10 px-2">
        <div class="size-8 text-primary">
            <svg fill="none" viewbox="0 0 48 48" xmlns="http://www.w3.org/2000/svg">
                <path clip-rule="evenodd"
                    d="M24 0.757355L47.2426 24L24 47.2426L0.757355 24L24 0.757355ZM21 35.7574V12.2426L9.24264 24L21 35.7574Z"
                    fill="currentColor" fill-rule="evenodd"></path>
            </svg>
        </div>
        <h2 class="text-xl font-bold tracking-tight">TechKart</h2>
    </div>
    <nav class="flex-1 space-y-2">
        <a class="flex items-center gap-3 px-4 py-3 rounded-xl hover:text-white hover:bg-white/5 transition-all <%= path === '/user/dashboard' ? 'bg-primary text-white font-medium' : 'text-white/60' %>"
            href="/user/dashboard">
            <span class="material-symbols-outlined">dashboard</span>
            <span>Dashboard</span>
        </a>
        <a class="flex items-center gap-3 px-4 py-3 rounded-xl transition-all <%= path === '/user/profile' ? 'bg-primary text-white font-medium' : 'text-white/60 hover:text-white hover:bg-white/5' %>"
            href="/user/profile">
            <span class="material-symbols-outlined">person</span>
            <span>Profile</span>
        </a>
        <a class="flex items-center gap-3 px-4 py-3 rounded-xl transition-all <%= path === '/user/orders' ? 'bg-primary text-white font-medium' : 'text-white/60 hover:text-white hover:bg-white/5' %>"
            href="/user/orders">
            <span class="material-symbols-outlined">package_2</span>
            <span>Orders</span>
        </a>
        <a class="flex items-center gap-3 px-4 py-3 rounded-xl transition-all <%= path === '/user/wallet' ? 'bg-primary text-white font-medium' : 'text-white/60 hover:text-white hover:bg-white/5' %>"
            href="/user/wallet">
            <span class="material-symbols-outlined">account_balance_wallet</span>
            <span>Wallet</span>
        </a>
        <a class="flex items-center gap-3 px-4 py-3 rounded-xl transition-all <%= path === '/user/address' ? 'bg-primary text-white font-medium' : 'text-white/60 hover:text-white hover:bg-white/5' %>"
            href="/user/address">
            <span class="material-symbols-outlined">location_on</span>
            <span>Addresses</span>
        </a>

        <!-- Security Dropdown -->
        <div class="space-y-1">
            <button onclick="toggleSecurityMenu()"
                class="w-full flex items-center justify-between px-4 py-3 rounded-xl text-white/60 hover:text-white hover:bg-white/5 transition-all group">
                <div class="flex items-center gap-3">
                    <span
                        class="material-symbols-outlined <%= (loginMethod === 'google') ? 'text-amber-500/50' : '' %>">
                        <%= (loginMethod==='google' ) ? 'lock' : 'security' %>
                    </span>
                    <span>Security</span>
                </div>
                <span id="securityChevron"
                    class="material-symbols-outlined text-sm transition-transform duration-300">expand_more</span>
            </button>
            <div id="securitySubmenu" class="hidden pl-11 space-y-1 overflow-hidden transition-all duration-300">
                <% if (loginMethod==='google' ) { %>
                    <!-- Blocked options for Google Users -->
                    <div
                        class="flex items-center gap-3 px-4 py-2 rounded-xl text-white/20 cursor-not-allowed select-none text-sm group/disabled relative hover:bg-white/[0.02]">
                        <span class="material-symbols-outlined text-[18px] text-amber-500/50">key</span>
                        <span class="flex-1 text-white/30">Change Password (Google)</span>
                        <span class="material-symbols-outlined text-sm text-white/20">lock</span>

                        <!-- Tooltip -->
                        <div
                            class="absolute left-full ml-4 px-3 py-2 bg-[#1A1D23] border border-white/10 rounded-xl text-[10px] whitespace-nowrap opacity-0 group-hover/disabled:opacity-100 transition-all duration-300 pointer-events-none z-50 shadow-2xl translate-x-[-10px] group-hover/disabled:translate-x-0">
                            <div class="flex items-center gap-2">
                                <img src="https://www.google.com/favicon.ico" class="size-3 grayscale opacity-50">
                                <span class="font-medium text-white/60">Managed by Google Security</span>
                            </div>
                        </div>
                    </div>
                    <div
                        class="flex items-center gap-3 px-4 py-2 rounded-xl text-white/20 cursor-not-allowed select-none text-sm group/disabled relative hover:bg-white/[0.02]">
                        <span class="material-symbols-outlined text-[18px] text-indigo-400/50">mail</span>
                        <span class="flex-1 text-white/30">Change Email (Google)</span>
                        <span class="material-symbols-outlined text-sm text-white/20">lock</span>

                        <!-- Tooltip -->
                        <div
                            class="absolute left-full ml-4 px-3 py-2 bg-[#1A1D23] border border-white/10 rounded-xl text-[10px] whitespace-nowrap opacity-0 group-hover/disabled:opacity-100 transition-all duration-300 pointer-events-none z-50 shadow-2xl translate-x-[-10px] group-hover/disabled:translate-x-0">
                            <div class="flex items-center gap-2">
                                <img src="https://www.google.com/favicon.ico" class="size-3 grayscale opacity-50">
                                <span class="font-medium text-white/60">Managed by Google Security</span>
                            </div>
                        </div>
                    </div>
                    <% } else { %>
                        <!-- Active options for Regular Users -->
                        <a href="/user/profile/change-password"
                            class="flex items-center gap-3 px-4 py-2 rounded-xl text-white/40 hover:text-white transition-all text-sm">
                            <span class="material-symbols-outlined text-sm">lock_reset</span>
                            <span>Change Password</span>
                        </a>
                        <a href="/user/profile/change-email"
                            class="flex items-center gap-3 px-4 py-2 rounded-xl text-white/40 hover:text-white transition-all text-sm">
                            <span class="material-symbols-outlined text-sm">mail</span>
                            <span>Change Email</span>
                        </a>
                        <% } %>
            </div>
        </div>
        <a class="flex items-center gap-3 px-4 py-3 rounded-xl text-rose-500 hover:text-rose-400 hover:bg-rose-500/10 transition-all mt-4 border border-rose-500/10"
            href="/user/logout">
            <span class="material-symbols-outlined">logout</span>
            <span>Logout</span>
        </a>
    </nav>
    <div class="mt-auto p-4 rounded-2xl glass-card flex items-center gap-3 border border-white/5">
        <div
            class="size-10 rounded-full bg-cover bg-center flex items-center justify-center bg-primary/20 text-primary font-bold overflow-hidden">
            <% if (user.profileImage && user.profileImage.startsWith('http')) { %>
                <img src="<%= user.profileImage %>" referrerpolicy="no-referrer" class="w-full h-full object-cover">
                <% } else { %>
                    <%= user.fullname.substring(0, 2).toUpperCase() %>
                        <% } %>
        </div>
        <div>
            <p class="text-sm font-bold">
                <%= user.fullname %>
            </p>
            <p class="text-xs text-primary font-medium">Member</p>
        </div>
    </div>
</aside>

<!-- Mobile Profile Bottom Dock -->
<nav class="lg:hidden fixed z-[110] bg-[#0D0D0D]/90 backdrop-blur-2xl border border-white/10 rounded-full shadow-[0_10px_40px_rgba(0,0,0,0.8)] left-4 right-4 max-w-[400px] mx-auto overflow-hidden" style="bottom: calc(1.25rem + env(safe-area-inset-bottom));">
    <div class="flex items-center h-[65px] px-6 gap-8 overflow-x-auto no-scrollbar w-full">
        <a href="/user/dashboard" class="flex flex-col items-center justify-center gap-1 <%= path === '/user/dashboard' ? 'text-primary' : 'text-gray-400 hover:text-white' %> transition-colors">
            <span class="material-symbols-outlined text-[22px] <%= path === '/user/dashboard' ? 'fill-current' : '' %>" style="font-variation-settings: 'FILL' <%= path === '/user/dashboard' ? '1' : '0' %>">dashboard</span>
            <span class="text-[9px] font-bold tracking-wider">Dashboard</span>
        </a>
        <a href="/user/profile" class="flex flex-col items-center justify-center gap-1 <%= path === '/user/profile' ? 'text-primary' : 'text-gray-400 hover:text-white' %> transition-colors">
            <span class="material-symbols-outlined text-[22px] <%= path === '/user/profile' ? 'fill-current' : '' %>" style="font-variation-settings: 'FILL' <%= path === '/user/profile' ? '1' : '0' %>">person</span>
            <span class="text-[9px] font-bold tracking-wider">Profile</span>
        </a>
        <a href="/user/orders" class="flex flex-col items-center justify-center gap-1 <%= path === '/user/orders' ? 'text-primary' : 'text-gray-400 hover:text-white' %> transition-colors">
            <span class="material-symbols-outlined text-[22px] <%= path === '/user/orders' ? 'fill-current' : '' %>" style="font-variation-settings: 'FILL' <%= path === '/user/orders' ? '1' : '0' %>">package_2</span>
            <span class="text-[9px] font-bold tracking-wider">Orders</span>
        </a>
        <a href="/user/wallet" class="flex flex-col items-center justify-center gap-1 <%= path === '/user/wallet' ? 'text-primary' : 'text-gray-400 hover:text-white' %> transition-colors">
            <span class="material-symbols-outlined text-[22px] <%= path === '/user/wallet' ? 'fill-current' : '' %>" style="font-variation-settings: 'FILL' <%= path === '/user/wallet' ? '1' : '0' %>">account_balance_wallet</span>
            <span class="text-[9px] font-bold tracking-wider">Wallet</span>
        </a>
        <a href="/user/address" class="flex flex-col items-center justify-center gap-1 <%= path === '/user/address' ? 'text-primary' : 'text-gray-400 hover:text-white' %> transition-colors">
            <span class="material-symbols-outlined text-[22px] <%= path === '/user/address' ? 'fill-current' : '' %>" style="font-variation-settings: 'FILL' <%= path === '/user/address' ? '1' : '0' %>">location_on</span>
            <span class="text-[9px] font-bold tracking-wider">Addresses</span>
        </a>
        <a href="/user/profile/change-password" class="flex flex-col items-center justify-center gap-1 <%= path === '/user/profile/change-password' || path === '/user/profile/change-email' ? 'text-primary' : 'text-gray-400 hover:text-white' %> transition-colors">
            <span class="material-symbols-outlined text-[22px] <%= path === '/user/profile/change-password' || path === '/user/profile/change-email' ? 'fill-current' : '' %>" style="font-variation-settings: 'FILL' <%= path === '/user/profile/change-password' || path === '/user/profile/change-email' ? '1' : '0' %>"><%= loginMethod === 'google' ? 'lock' : 'security' %></span>
            <span class="text-[9px] font-bold tracking-wider">Security</span>
        </a>
        <a href="/user/logout" class="flex flex-col items-center justify-center gap-1 text-rose-500 hover:text-rose-400 transition-colors">
            <span class="material-symbols-outlined text-[22px]">logout</span>
            <span class="text-[9px] font-bold tracking-wider">Logout</span>
        </a>
    </div>
</nav>

<style>
/* Hide scrollbar for Chrome, Safari and Opera */
.no-scrollbar::-webkit-scrollbar {
  display: none;
}
/* Hide scrollbar for IE, Edge and Firefox */
.no-scrollbar {
  -ms-overflow-style: none;  /* IE and Edge */
  scrollbar-width: none;  /* Firefox */
}
</style>

<script src="/js/partials/sidebar.js"></script>