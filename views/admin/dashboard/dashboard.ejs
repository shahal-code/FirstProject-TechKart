                <span class="material-symbols-outlined text-primary/60">payments</span>
              </div>
              <div class="flex items-end gap-3">
                <h3 class="text-3xl font-bold tracking-tight">₹428,192</h3>
                <span class="text-emerald-400 text-xs font-bold pb-1 flex items-center">+12.5%</span>
              </div>
              <div class="mt-6 h-12 w-full relative">
                <svg class="w-full h-full" viewBox="0 0 200 60">
