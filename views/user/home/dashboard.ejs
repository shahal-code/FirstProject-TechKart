                                    <div
                                        class="absolute top-6 left-6 bg-amber-500 text-white px-4 py-1.5 rounded-full text-[10px] font-black uppercase tracking-widest shadow-lg">
                                        Hot Seller</div>
                                </div>
                                <div class="p-8">
                                    <div class="flex justify-between items-start mb-3">
                                        <h3 class="text-white text-2xl font-black premium-heading">FLOW AIR</h3>
                                        <span class="text-primary font-bold text-2xl">$799</span>
                                    </div>
                                    <p class="text-gray-400 text-sm mb-8 leading-relaxed">Feather-light Design • 18hr
                                        Pro
                                        Battery • Liquid Cooling Tech</p>
                                    <button
                                        class="w-full flex items-center justify-center gap-3 bg-white text-black font-black text-xs uppercase tracking-widest py-4 rounded-full hover:bg-primary hover:text-white transition-all duration-300">
                                        <span class="material-symbols-outlined text-lg">add_shopping_cart</span>
