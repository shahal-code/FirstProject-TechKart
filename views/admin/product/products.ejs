<!DOCTYPE html>
<html class="dark" lang="en">
<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>TechKart Admin - Product Inventory</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
    <script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        "primary": "#0055ff",
                        "background-dark": "#0d0d0d",
                    },
                    fontFamily: {
                        "display": ["Space Grotesk", "sans-serif"]
                    },
                },
            },
        }
    </script>
    <style type="text/tailwindcss">
        body {
            font-family: 'Space Grotesk', sans-serif;
            @apply bg-background-dark text-white;
        }
        .glass-morphism {
            background: rgba(23, 33, 54, 0.6);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border: 1px solid rgba(255, 255, 255, 0.08);
        }
        .sidebar-item-active {
            @apply bg-primary/10 text-primary border-r-2 border-primary shadow-[inset_0_0_20px_rgba(0,85,255,0.1)];
        }
        .stat-card {
            @apply glass-morphism rounded-xl p-6 relative overflow-hidden;
        }
        .custom-scrollbar::-webkit-scrollbar {
            width: 4px;
        }
        .custom-scrollbar::-webkit-scrollbar-track {
            background: transparent;
        }
        .custom-scrollbar::-webkit-scrollbar-thumb {
            background: rgba(255, 255, 255, 0.1);
            border-radius: 10px;
        }
        .input-field {
            @apply bg-[#151923] border border-white/5 rounded-xl py-3 px-4 text-sm focus:outline-none focus:ring-1 focus:ring-primary focus:border-primary transition-all placeholder:text-slate-600;
        }
        .filter-select {
            @apply bg-transparent text-sm text-slate-300 font-medium py-2 pr-8 focus:outline-none focus:ring-0 border-none appearance-none cursor-pointer;
        }
    </style>
</head>

<body class="flex min-h-screen bg-[#0D0D0D]">
    <%- include('../../partials/admin/sidebar') %>

    <main class="flex-1 flex flex-col relative overflow-y-auto custom-scrollbar">
        <%- include('../../partials/admin/header') %>

        <div class="p-8 lg:p-12 space-y-8">
            <!-- Header Area -->
            <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
                <div>
                    <h2 class="text-3xl font-bold tracking-tight mb-1">Product Inventory</h2>
                    <p class="text-sm text-slate-500 font-medium">Manage your hardware catalog</p>
                </div>
                <button onclick="window.location.href='/admin/addProduct'"
                    class="flex items-center gap-2 bg-primary hover:bg-primary/90 text-white px-6 py-3 rounded-full font-bold text-sm tracking-wide transition-all shadow-[0_4px_20px_rgba(0,85,255,0.4)]">
                    <span class="material-symbols-outlined text-sm">add</span>
                    ADD NEW PRODUCT
                </button>
            </div>

            <!-- Stats grid -->
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                <!-- Stat 1 -->
                <div class="stat-card">
                    <div class="flex justify-between items-start mb-6">
                        <p class="text-xs font-bold text-slate-400">Total Products</p>
                        <span class="material-symbols-outlined text-primary text-xl">inventory_2</span>
                    </div>
                    <div class="flex items-end gap-3">
                        <h3 class="text-4xl font-bold tracking-tight"><%= totalProducts || 0 %></h3>
                    </div>
                </div>
            </div>

            <!-- Table Section -->
            <section class="glass-morphism rounded-2xl overflow-hidden border border-white/5">
                <!-- Filters -->
                <div class="p-6 border-b border-white/5 flex flex-wrap items-center justify-between gap-4">
                    <div class="flex items-center gap-6">
                        <button class="bg-primary text-white text-xs font-bold px-5 py-2 rounded-lg">Apply Filters</button>
                        <button class="text-slate-400 text-xs hover:text-white transition-colors">Reset Filters</button>
                    </div>

                    <div class="relative">
                        <input type="text" placeholder="Search" class="!bg-white/5 border border-white/10 rounded-full py-2 pl-4 pr-10 text-sm w-64 focus:outline-none focus:border-primary text-white placeholder:text-slate-500">
                        <span class="material-symbols-outlined absolute right-4 top-1/2 -translate-y-1/2 text-slate-500 text-sm">search</span>
                    </div>
                </div>

                <!-- Table -->
                <div class="overflow-x-auto">
                    <table class="w-full text-left border-collapse">
                        <thead>
                            <tr class="border-b border-white/5 text-xs text-slate-500 font-medium">
                                <th class="px-6 py-4 font-medium">Image</th>
                                <th class="px-6 py-4 font-medium">Product Name</th>
                                <th class="px-6 py-4 font-medium">Category</th>
                                <th class="px-6 py-4 font-medium">Price</th>
                                <th class="px-6 py-4 font-medium text-right">Action</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-white/5 text-sm">
                            <% if(products && products.length > 0) { %>
                                <% products.forEach(p => { %>
                                <tr class="hover:bg-white/5 transition-colors group">
                                    <td class="px-6 py-4">
                                        <div class="w-12 h-12 rounded-xl bg-[#151923] border border-white/5 flex items-center justify-center overflow-hidden">
                                            <% if(p.images && p.images.length > 0) { %>
                                                <img src="<%= p.images[0] %>" class="w-full h-full object-cover">
                                            <% } else { %>
                                                <div class="w-8 h-6 bg-gradient-to-r from-emerald-400 to-cyan-400 rounded-sm opacity-50"></div>
                                            <% } %>
                                        </div>
                                    </td>
                                    <td class="px-6 py-4">
                                        <p class="font-bold text-white mb-1"><%= p.name %></p>
                                        <p class="text-[10px] text-slate-500 uppercase tracking-wider">SKU: <%= p.variants[0]?.sku || 'N/A' %></p>
                                    </td>
                                    <td class="px-6 py-4">
                                        <span class="px-3 py-1 rounded-full bg-primary/10 text-primary text-[10px] font-bold border border-primary/20"><%= p.category_id ? p.category_id.name : 'Unknown' %></span>
                                    </td>
                                    <td class="px-6 py-4 font-bold">$<%= p.variants[0]?.price || 0 %></td>
                                    <td class="px-6 py-4 text-right">
                                        <button onclick="confirmDelete('<%= p._id %>')" class="text-rose-500 hover:text-rose-400 transition-colors">
                                            <span class="material-symbols-outlined text-lg">delete</span>
                                        </button>
                                    </td>
                                </tr>
                                <% }) %>
                            <% } else { %>
                                <tr><td colspan="5" class="px-6 py-4 text-center text-slate-500">No products found.</td></tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>

            </section>
        </div>
    </main>
    <script>
        function confirmDelete(id) {
            Swal.fire({
                title: 'Are you want to delete ?',
                background: '#11151F',
                color: '#fff',
                showCancelButton: true,
                confirmButtonColor: '#f43f5e',
                cancelButtonColor: '#10b981',
                confirmButtonText: 'Delete Product',
                cancelButtonText: 'Cancel'
            }).then((result) => {
                if (result.isConfirmed) {
                     fetch('/admin/product/delete/' + id, {method: 'DELETE'})
                     .then(() => window.location.reload());
                }
            });
        }
    </script>
</body>
</html>
