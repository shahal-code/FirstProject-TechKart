<!DOCTYPE html>
<html class="dark" lang="en">

<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>TechKart Admin - Orders Management</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&amp;display=swap"
        rel="stylesheet" />
    <link
        href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap"
        rel="stylesheet" />
    <script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        "primary": "#0055ff",
                        "background-light": "#f5f6f8",
                        "background-dark": "#0d0d0d",
                        "card-bg": "rgba(23, 33, 54, 0.4)",
                    },
                    fontFamily: {
                        "display": ["Space Grotesk", "sans-serif"]
                    },
                    borderRadius: {
                        "DEFAULT": "0.5rem",
                        "lg": "1rem",
                        "xl": "1.5rem",
                        "full": "9999px"
                    },
                },
            },
        }
    </script>
    <style type="text/tailwindcss">
        body {
            font-family: 'Space Grotesk', sans-serif;
            @apply bg-background-dark text-white;
        }
        .glass-morphism {
            background: rgba(23, 33, 54, 0.6);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border: 1px solid rgba(255, 255, 255, 0.08);
        }
        .sidebar-item-active {
            @apply bg-primary/10 text-primary border-r-2 border-primary shadow-[inset_0_0_20px_rgba(0,85,255,0.1)];
        }
        .input-field {
            @apply w-full bg-white/5 border border-white/10 rounded-lg py-2.5 px-4 text-sm focus:ring-1 focus:ring-primary focus:border-primary text-slate-200 placeholder-slate-500 transition-all outline-none;
        }
        .label-text {
            @apply text-[10px] font-bold text-slate-400 uppercase tracking-widest mb-2 block;
        }
        .custom-scrollbar::-webkit-scrollbar {
            width: 4px;
        }
        .custom-scrollbar::-webkit-scrollbar-track {
            background: transparent;
        }
        .custom-scrollbar::-webkit-scrollbar-thumb {
            background: rgba(255, 255, 255, 0.1);
            border-radius: 10px;
        }
        .status-badge {
            @apply px-2.5 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-wider inline-flex items-center gap-1.5;
        }
        .status-processing { @apply bg-amber-500/10 text-amber-500 border border-amber-500/20; }
        .status-shipped { @apply bg-primary/10 text-primary border border-primary/20; }
        .status-delivered { @apply bg-emerald-500/10 text-emerald-500 border border-emerald-500/20; }
        .status-cancelled { @apply bg-rose-500/10 text-rose-500 border border-rose-500/20; }
    </style>
</head>

<body class="flex min-h-screen">
       <%- include('../../partials/admin/sidebar') %>
      <main class="flex-1 flex flex-col relative overflow-y-auto custom-scrollbar min-w-0">
            <!-- Header -->
            <%- include('../../partials/admin/header') %>
        <div class="p-10 max-w-[1600px] mx-auto w-full space-y-8">
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
                <div class="glass-morphism p-6 rounded-xl border-l-4 border-primary">
                    <div class="flex justify-between items-start mb-4">
                        <span
                            class="material-symbols-outlined text-primary bg-primary/10 p-2 rounded-lg">shopping_bag</span>
                        <span class="text-xs font-bold text-emerald-500">+12%</span>
                    </div>
                    <h4 class="text-2xl font-bold tracking-tight">1,284</h4>
                    <p class="text-[10px] text-slate-400 font-bold uppercase tracking-widest">Total Orders</p>
                </div>
                <div class="glass-morphism p-6 rounded-xl border-l-4 border-amber-500">
                    <div class="flex justify-between items-start mb-4">
                        <span
                            class="material-symbols-outlined text-amber-500 bg-amber-500/10 p-2 rounded-lg">pending_actions</span>
                        <span class="text-xs font-bold text-amber-500">High Priority</span>
                    </div>
                    <h4 class="text-2xl font-bold tracking-tight">42</h4>
                    <p class="text-[10px] text-slate-400 font-bold uppercase tracking-widest">Pending</p>
                </div>
                <div class="glass-morphism p-6 rounded-xl border-l-4 border-primary">
                    <div class="flex justify-between items-start mb-4">
                        <span
                            class="material-symbols-outlined text-primary bg-primary/10 p-2 rounded-lg">local_shipping</span>
                        <span class="text-xs font-bold text-slate-400">8 In Transit</span>
                    </div>
                    <h4 class="text-2xl font-bold tracking-tight">156</h4>
                    <p class="text-[10px] text-slate-400 font-bold uppercase tracking-widest">In Transit</p>
                </div>
                <div class="glass-morphism p-6 rounded-xl border-l-4 border-emerald-500">
                    <div class="flex justify-between items-start mb-4">
                        <span
                            class="material-symbols-outlined text-emerald-500 bg-emerald-500/10 p-2 rounded-lg">check_circle</span>
                        <span class="text-xs font-bold text-emerald-500">Completed</span>
                    </div>
                    <h4 class="text-2xl font-bold tracking-tight">1,086</h4>
                    <p class="text-[10px] text-slate-400 font-bold uppercase tracking-widest">Completed</p>
                </div>
            </div>
            <section class="glass-morphism rounded-xl overflow-hidden">
            <!-- Filter Section -->
            <div class="glass-morphism p-8 rounded-xl border border-white/5 mb-6">
                <form action="/admin/orders" method="GET" class="grid grid-cols-1 md:grid-cols-4 gap-6 items-end">
                    <!-- Date Range -->
                    <div class="space-y-2">
                        <label class="label-text">Date Range</label>
                        <div class="flex gap-2">
                            <input type="date" name="startDate" class="input-field text-xs" value="<%= filters?.startDate || '' %>">
                            <input type="date" name="endDate" class="input-field text-xs" value="<%= filters?.endDate || '' %>">
                        </div>
                    </div>

                    <!-- Order Status -->
                    <div class="space-y-2">
                        <label class="label-text">Order Status</label>
                        <div class="relative">
                            <select name="status" class="input-field appearance-none pr-10">
                                <option value="">All Status</option>
                                <option value="Pending" <%= filters?.status === 'Pending' ? 'selected' : '' %>>Pending</option>
                                <option value="Processing" <%= filters?.status === 'Processing' ? 'selected' : '' %>>Processing</option>
                                <option value="Shipped" <%= filters?.status === 'Shipped' ? 'selected' : '' %>>Shipped</option>
                                <option value="Delivered" <%= filters?.status === 'Delivered' ? 'selected' : '' %>>Delivered</option>
                                <option value="Cancelled" <%= filters?.status === 'Cancelled' ? 'selected' : '' %>>Cancelled</option>
                            </select>
                            <span class="material-symbols-outlined absolute right-3 top-1/2 -translate-y-1/2 text-slate-500 pointer-events-none text-sm">expand_more</span>
                        </div>
                    </div>

                    <!-- Payment Method -->
                    <div class="space-y-2">
                        <label class="label-text">Payment Method</label>
                        <div class="relative">
                            <select name="paymentMethod" class="input-field appearance-none pr-10">
                                <option value="">All Methods</option>
                                <option value="COD" <%= filters?.paymentMethod === 'COD' ? 'selected' : '' %>>Cash on Delivery</option>
                                <option value="Online" <%= filters?.paymentMethod === 'Online' ? 'selected' : '' %>>Online Payment</option>
                            </select>
                            <span class="material-symbols-outlined absolute right-3 top-1/2 -translate-y-1/2 text-slate-500 pointer-events-none text-sm">expand_more</span>
                        </div>
                    </div>

                    <!-- Filter Action Buttons -->
                    <div class="flex gap-3">
                        <button type="submit" class="flex-1 bg-primary hover:bg-primary/80 text-white text-[10px] font-bold py-3 rounded-lg transition-all shadow-[0_0_15px_rgba(0,85,255,0.2)]">
                            APPLY FILTERS
                        </button>
                        <a href="/admin/orders" class="px-4 py-3 border border-white/10 hover:bg-white/5 rounded-lg text-[10px] font-bold text-slate-400 transition-all text-center">
                            RESET
                        </a>
                    </div>
                </form>
            </div>

            <!-- Search Bar Section -->
            <div class="glass-morphism p-6 rounded-xl border border-white/5 mb-8 flex flex-col md:flex-row md:items-center justify-between gap-4">
                <form action="/admin/orders" method="GET" class="flex gap-4 flex-1">
                    <div class="relative flex-1">
                        <span class="material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2 text-slate-500 text-lg">search</span>
                        <input name="search" type="text" class="input-field pl-12 py-3" placeholder="Search Order ID, Customer Name..." value="<%= filters?.search || '' %>">
                    </div>
                    <button type="submit" class="bg-primary px-10 py-3 rounded-lg text-[10px] font-bold hover:shadow-[0_0_20px_rgba(0,85,255,0.4)] transition-all uppercase tracking-widest">
                        Search
                    </button>
                </form>
            </div>

            <section class="glass-morphism rounded-xl overflow-hidden">
                <div class="overflow-x-auto">
                    <table class="w-full text-left border-collapse">
                        <thead>
                            <tr class="border-b border-white/5 bg-white/[0.02]">
                                <th class="px-8 py-4 text-[10px] font-bold text-slate-400 uppercase tracking-widest">
                                    Order ID</th>
                                <th class="px-6 py-4 text-[10px] font-bold text-slate-400 uppercase tracking-widest">
                                    Customer Name</th>
                                <th class="px-6 py-4 text-[10px] font-bold text-slate-400 uppercase tracking-widest">
                                    Product</th>
                                <th class="px-6 py-4 text-[10px] font-bold text-slate-400 uppercase tracking-widest">
                                    Order Date</th>
                                <th class="px-6 py-4 text-[10px] font-bold text-slate-400 uppercase tracking-widest">
                                    Status</th>
                                <th class="px-6 py-4 text-[10px] font-bold text-slate-400 uppercase tracking-widest">
                                    Total Amount</th>
                                <th
                                    class="px-8 py-4 text-[10px] font-bold text-slate-400 uppercase tracking-widest text-right">
                                    Actions</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-white/5">
                            <% if (orders && orders.length > 0) { %>
                                <% orders.forEach(order => { %>
                                    <tr class="hover:bg-white/[0.03] transition-colors group">
                                        <td class="px-8 py-4">
                                            <span class="text-sm font-bold text-primary font-mono"><%= order.orderId %></span>
                                        </td>
                                        <td class="px-6 py-4">
                                            <div class="flex items-center gap-3">
                                                <div class="h-8 w-8 rounded-full bg-primary/10 flex items-center justify-center text-[10px] font-bold text-primary">
                                                    <%= (order.userId && order.userId.fullname) ? order.userId.fullname.split(' ').map(n => n[0]).join('') : 'U' %>
                                                </div>
                                                <span class="text-sm font-medium"><%= (order.userId && order.userId.fullname) ? order.userId.fullname : 'Unknown User' %></span>
                                            </div>
                                        </td>
                                        <td class="px-6 py-4">
                                            <span class="text-sm text-slate-300">
                                                <%= order.orderedItems[0]?.product?.name || 'Product' %> 
                                                <% if (order.orderedItems.length > 1) { %>
                                                    <span class="text-[10px] text-slate-500">(+<%= order.orderedItems.length - 1 %> more)</span>
                                                <% } %>
                                            </span>
                                        </td>
                                        <td class="px-6 py-4 text-sm text-slate-400">
                                            <%= new Date(order.createdAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %>
                                        </td>
                                        <td class="px-6 py-4">
                                            <% 
                                                let statusClass = 'status-processing';
                                                if (order.status === 'Shipped') statusClass = 'status-shipped';
                                                if (order.status === 'Delivered') statusClass = 'status-delivered';
                                                if (order.status === 'Cancelled') statusClass = 'status-cancelled';
                                            %>
                                            <span class="status-badge <%= statusClass %>"><%= order.status %></span>
                                        </td>
                                        <td class="px-6 py-4 text-sm font-bold">₹<%= order.finalAmount.toLocaleString() %></td>
                                        <td class="px-8 py-4 text-right">
                                            <div class="flex justify-end gap-2">
                                                <a href="/admin/orders/<%= order._id %>"
                                                    class="p-1.5 rounded-lg text-slate-400 hover:text-primary hover:bg-primary/10 transition-all">
                                                    <span class="material-symbols-outlined text-xl">visibility</span>
                                                </a>
                                                <button
                                                    class="p-1.5 rounded-lg text-slate-400 hover:text-primary hover:bg-primary/10 transition-all">
                                                    <span class="material-symbols-outlined text-xl">edit</span>
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                <% }) %>
                            <% } else { %>
                                <tr>
                                    <td colspan="7" class="px-8 py-10 text-center text-slate-500">
                                        <span class="material-symbols-outlined text-4xl mb-2">inventory_2</span>
                                        <p class="text-sm font-medium">No orders found</p>
                                    </td>
                                </tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
                <!-- Dynamic Pagination -->
                <div class="p-6 border-t border-white/5 flex items-center justify-between">
                    <% 
                        const showingStart = (page - 1) * 10 + 1;
                        const showingEnd = Math.min(page * 10, totalOrders);
                    %>
                    <p class="text-[10px] font-bold text-slate-500 uppercase tracking-widest">
                        Showing <%= totalOrders > 0 ? showingStart : 0 %>-<%= showingEnd %> of <%= totalOrders %> results
                    </p>
                    
                    <div class="flex items-center gap-2">
                        <!-- Previous Page -->
                        <% if (page > 1) { %>
                            <a href="?page=<%= page - 1 %><%= Object.entries(filters).filter(([k]) => k !== 'page').map(([k, v]) => `&${k}=${v}`).join('') %>"
                                class="px-3 py-1.5 rounded-lg border border-white/10 text-slate-400 hover:bg-white/5 transition-all">
                                <span class="material-symbols-outlined text-lg leading-none">chevron_left</span>
                            </a>
                        <% } else { %>
                            <button class="px-3 py-1.5 rounded-lg border border-white/10 text-slate-400 opacity-30 cursor-not-allowed" disabled>
                                <span class="material-symbols-outlined text-lg leading-none">chevron_left</span>
                            </button>
                        <% } %>

                        <!-- Page Numbers -->
                        <% 
                            let startPage = Math.max(1, page - 2);
                            let endPage = Math.min(totalPages, startPage + 4);
                            if (endPage - startPage < 4) startPage = Math.max(1, endPage - 4);
                        %>

                        <% for (let i = startPage; i <= endPage; i++) { %>
                            <a href="?page=<%= i %><%= Object.entries(filters).filter(([k]) => k !== 'page').map(([k, v]) => `&${k}=${v}`).join('') %>"
                                class="h-8 w-8 rounded-lg flex items-center justify-center text-xs font-bold transition-all <%= i === page ? 'bg-primary text-white shadow-[0_0_15px_rgba(0,85,255,0.4)]' : 'border border-white/10 text-slate-400 hover:bg-white/5' %>">
                                <%= i %>
                            </a>
                        <% } %>

                        <!-- Next Page -->
                        <% if (page < totalPages) { %>
                            <a href="?page=<%= page + 1 %><%= Object.entries(filters).filter(([k]) => k !== 'page').map(([k, v]) => `&${k}=${v}`).join('') %>"
                                class="px-3 py-1.5 rounded-lg border border-white/10 text-slate-400 hover:bg-white/5 transition-all">
                                <span class="material-symbols-outlined text-lg leading-none">chevron_right</span>
                            </a>
                        <% } else { %>
                            <button class="px-3 py-1.5 rounded-lg border border-white/10 text-slate-400 opacity-30 cursor-not-allowed" disabled>
                                <span class="material-symbols-outlined text-lg leading-none">chevron_right</span>
                            </button>
                        <% } %>
                    </div>
                </div>
            </section>
        </div>
    </main>
    <div
        class="fixed top-[-10%] left-[-10%] w-[40%] h-[40%] bg-primary/5 blur-[120px] pointer-events-none -z-10 rounded-full">
    </div>
    <div
        class="fixed bottom-[-10%] right-[-10%] w-[40%] h-[40%] bg-primary/5 blur-[120px] pointer-events-none -z-10 rounded-full">
    </div>

</body>

</html>