<!DOCTYPE html>
<html class="dark" lang="en">

<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>TechKart Admin - Edit Coupon</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
    <script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: { "primary": "#0055ff", "background-dark": "#0d0d0d" },
                    fontFamily: { "display": ["Space Grotesk", "sans-serif"] },
                },
            },
        }
    </script>
    <style type="text/tailwindcss">
        body { font-family: 'Space Grotesk', sans-serif; background-color: #0d0d0d; color: #ffffff; }
        .glass-morphism {
            background: rgba(23, 33, 54, 0.6);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border: 1px solid rgba(255, 255, 255, 0.08);
        }
        .input-field {
            background-color: rgba(255, 255, 255, 0.05);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 1rem;
            padding: 0.875rem 1.25rem;
            font-size: 0.875rem;
            color: white;
            width: 100%;
            transition: all 0.2s ease;
        }
        .input-field:focus { outline: none; box-shadow: 0 0 0 1px #0055ff; border-color: #0055ff; }
        .input-field::placeholder { color: #475569; }
        .custom-scrollbar::-webkit-scrollbar { width: 4px; }
        .custom-scrollbar::-webkit-scrollbar-track { background: transparent; }
        .custom-scrollbar::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.1); border-radius: 10px; }
    </style>
</head>

<body class="flex min-h-screen bg-[#0D0D0D]">
    <%- include('../../partials/admin/sidebar') %>

    <main class="flex-1 flex flex-col relative overflow-y-auto custom-scrollbar">
        <%- include('../../partials/admin/header') %>

        <div class="p-10 max-w-3xl mx-auto w-full space-y-8">
            <!-- Breadcrumbs -->
            <nav class="flex items-center gap-2 text-[10px] font-bold uppercase tracking-widest text-slate-500">
                <a href="/admin/coupons" class="hover:text-primary transition-colors">Coupons</a>
                <span class="material-symbols-outlined text-xs">chevron_right</span>
                <span class="text-slate-300">Edit Coupon</span>
            </nav>

            <div class="flex justify-between items-end">
                <div>
                    <h2 class="text-3xl font-bold tracking-tight">Edit Coupon</h2>
                    <p class="text-xs text-slate-500 uppercase tracking-widest font-medium mt-1">
                        Editing: <span class="text-primary"><%= coupon.code %></span>
                    </p>
                </div>
                <a href="/admin/coupons" class="flex items-center gap-2 text-slate-400 hover:text-white transition-colors text-[10px] font-bold uppercase tracking-widest">
                    <span class="material-symbols-outlined text-sm">arrow_back</span>
                    Back to List
                </a>
            </div>

            <section class="glass-morphism rounded-3xl p-10 border border-white/5 relative overflow-hidden">
                <form id="editCouponForm" class="grid grid-cols-2 gap-6 relative z-10">

                    <!-- Coupon Code -->
                    <div class="col-span-2">
                        <label class="text-[10px] font-bold text-slate-400 uppercase tracking-widest mb-3 block">Coupon Code</label>
                        <input type="text" id="couponCode" value="<%= coupon.code %>"
                            class="input-field !uppercase font-bold" />
                    </div>

                    <!-- Discount Type -->
                    <div>
                        <label class="text-[10px] font-bold text-slate-400 uppercase tracking-widest mb-3 block">Discount Type</label>
                        <select id="discountType" onchange="updateValueLabel()" class="input-field appearance-none">
                            <option value="percentage" <%= coupon.discountType === 'percentage' ? 'selected' : '' %>>Percentage (%)</option>
                            <option value="flat" <%= coupon.discountType === 'flat' ? 'selected' : '' %>>Fixed Amount (₹)</option>
                        </select>
                    </div>

                    <!-- Discount Value -->
                    <div>
                        <label id="valueLabel" class="text-[10px] font-bold text-slate-400 uppercase tracking-widest mb-3 block">
                            Discount Value (<%= coupon.discountType === 'percentage' ? '%' : '₹' %>)
                        </label>
                        <input type="number" id="discountValue" min="1" value="<%= coupon.discountValue %>" class="input-field" />
                    </div>

                    <!-- Min Purchase -->
                    <div>
                        <label class="text-[10px] font-bold text-slate-400 uppercase tracking-widest mb-3 block">Min. Purchase Amount (₹)</label>
                        <input type="number" id="minPurchaseAmount" min="0" value="<%= coupon.minPurchaseAmount || 0 %>" class="input-field" />
                    </div>

                    <!-- Max Discount -->
                    <div>
                        <label class="text-[10px] font-bold text-slate-400 uppercase tracking-widest mb-3 block">
                            Max Discount Cap (₹) <span class="normal-case text-slate-600 font-normal">optional</span>
                        </label>
                        <input type="number" id="maxDiscountAmount" min="0" value="<%= coupon.maxDiscountAmount || '' %>" placeholder="Leave blank for no cap" class="input-field" />
                    </div>

                    <!-- Expiration Date -->
                    <div class="col-span-2">
                        <label class="text-[10px] font-bold text-slate-400 uppercase tracking-widest mb-3 block">Expiration Date</label>
                        <input type="date" id="expirationDate" value="<%= new Date(coupon.expirationDate).toISOString().split('T')[0] %>" class="input-field" />
                    </div>

                    <!-- Buttons -->
                    <div class="col-span-2 pt-2 flex gap-4">
                        <button type="button" onclick="submitEdit()"
                            class="flex-1 bg-primary hover:bg-primary/90 text-white py-4 rounded-2xl font-bold text-xs uppercase tracking-widest transition-all shadow-[0_8px_25px_rgba(0,85,255,0.3)]">
                            Save Changes
                        </button>
                        <button type="button" onclick="window.location.href='/admin/coupons'"
                            class="px-8 py-4 rounded-2xl border border-white/10 text-slate-400 hover:text-white hover:bg-white/5 transition-all text-xs font-bold uppercase tracking-widest">
                            Cancel
                        </button>
                    </div>

                </form>

                <!-- Background Glow -->
                <div class="absolute top-0 right-0 w-64 h-64 bg-primary/10 blur-[100px] pointer-events-none -z-10 rounded-full"></div>
            </section>
        </div>
    </main>

    <script>
        function updateValueLabel() {
            const type = document.getElementById('discountType').value;
            document.getElementById('valueLabel').textContent =
                type === 'percentage' ? 'Discount Value (%)' : 'Discount Value (₹)';
        }

        async function submitEdit() {
            const code = document.getElementById('couponCode').value.trim().toUpperCase();
            const discountType = document.getElementById('discountType').value;
            const discountValue = parseFloat(document.getElementById('discountValue').value);
            const minPurchaseAmount = parseFloat(document.getElementById('minPurchaseAmount').value) || 0;
            const maxDiscountAmount = parseFloat(document.getElementById('maxDiscountAmount').value) || null;
            const expirationDate = document.getElementById('expirationDate').value;

            if (!code || !discountValue || !expirationDate) {
                return Swal.fire({ icon: 'warning', title: 'Missing Fields', text: 'Code, Value and Expiry Date are required.', background: '#0f1420', color: '#fff' });
            }

            try {
                const res = await fetch('/admin/coupons/update/<%= coupon._id %>', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ code, discountType, discountValue, minPurchaseAmount, maxDiscountAmount, expirationDate })
                });
                const data = await res.json();
                if (data.success) {
                    Swal.fire({ icon: 'success', title: 'Updated!', text: data.message, background: '#0f1420', color: '#fff', timer: 1500, showConfirmButton: false })
                        .then(() => window.location.href = '/admin/coupons');
                } else {
                    Swal.fire({ icon: 'error', title: 'Error', text: data.message, background: '#0f1420', color: '#fff' });
                }
            } catch (err) {
                Swal.fire({ icon: 'error', title: 'Error', text: 'Something went wrong.', background: '#0f1420', color: '#fff' });
            }
        }
    </script>
</body>
</html>
