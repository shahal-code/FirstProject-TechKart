                                        Shop All Laptops
                                    </button>
                                    <button
                                        class="flex min-w-[200px] cursor-pointer items-center justify-center overflow-hidden rounded-full h-14 px-8 border border-white/20 text-white text-sm font-bold uppercase tracking-widest hover:bg-white/5 transition-all">
                                        Explore Lineup
                                    </button>
                                </div>
                            </div>
                            <div class="relative mt-12 lg:mt-0">
                                <div class="relative z-10 w-full aspect-square bg-center bg-cover bg-no-repeat rounded-3xl shadow-2xl border border-white/10"
                                    style='background-image: url("https://lh3.googleusercontent.com/aida-public/AB6AXuC6dimibt_t4FisiP5Li4TwUc_V7o7qcrtwkIQWa8aaIRmbTqrbeTkv43wL7sY4IT63Ivfcty31ooifdC7zAQjTdUbpYK-hmvkWMCDExuqIxqNPtK22LW64rGicjKkBVepPHCWtBGZkDhUlHpvNB_oAXciUA-rRWSjf3jGwx5zgXnzuDZ3s5faZFQB3tyZpJQaaDUC_MASzmQZKwBAClE_LdUOwYnKT8me7Ok7Cw1YMybK6sI0FudHDHav83nRj76qnczC7HE1DchTC");'>
                                </div>
                                <div
                                    class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[140%] h-[140%] bg-primary/15 blur-[120px] rounded-full -z-10 animate-pulse">
                                </div>

                                <!-- Floating Card -->
                                <div
                                    class="absolute -bottom-8 -left-8 z-20 glass-card p-6 rounded-2xl shadow-2xl hidden md:block min-w-[240px]">
                                    <div class="flex items-center gap-4">
                                        <div
                                            class="bg-primary p-3 rounded-xl shadow-[0_0_20px_rgba(0,85,255,0.4)] flex items-center justify-center">
                                            <span class="material-symbols-outlined text-white text-2xl">bolt</span>
                                        </div>
                                        <div>
                                            <p
                                                class="text-[10px] font-black text-primary uppercase tracking-[0.2em] mb-0.5">
                                                ULTRA-CORE GEN 3</p>
                                            <p class="text-sm text-white font-bold">Unrivaled Processing</p>
                                        </div>
                                    </div>
                                </div>

                                <!-- Floating badge -->
                                <div
                                    class="absolute -top-6 -right-6 z-20 glass-card p-4 rounded-xl shadow-2xl hidden lg:block backdrop-blur-md">
                                    <div class="flex items-center gap-3">
                                        <span class="material-symbols-outlined text-emerald-500">check_circle</span>
                                        <span class="text-[10px] text-white font-bold uppercase tracking-widest">In
                                            Stock &
                                            Ready to Ship</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="bg-white/[0.02] py-24 border-y border-white/5">
                        <div class="max-w-[1200px] mx-auto px-4">
                            <div class="mb-16 text-center">
                                <h2 class="text-white text-4xl font-black premium-heading uppercase mb-4">Choose Your
                                    Path
                                </h2>
                                <div class="h-1 w-20 bg-primary mx-auto rounded-full"></div>
                            </div>
                            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
                                <div
                                    class="glass-card group flex flex-col gap-6 rounded-2xl p-8 transition-all cursor-pointer">
                                    <div
                                        class="bg-white/5 size-14 flex items-center justify-center rounded-2xl text-primary group-hover:bg-primary group-hover:text-white transition-all duration-300">
                                        <span class="material-symbols-outlined text-3xl">sports_esports</span>
                                    </div>
                                    <div class="flex flex-col gap-2">
                                        <h3 class="text-white text-xl font-bold premium-heading">GAMING</h3>
                                        <p class="text-gray-400 text-sm leading-relaxed">High-refresh rates and
                                            desktop-class graphics for enthusiasts.</p>
                                    </div>
                                    <div
                                        class="flex items-center text-primary text-[11px] font-black uppercase tracking-widest mt-auto">
                                        Learn More <span
                                            class="material-symbols-outlined text-sm ml-2 group-hover:translate-x-2 transition-transform">arrow_forward</span>
                                    </div>
                                </div>
                                <div
                                    class="glass-card group flex flex-col gap-6 rounded-2xl p-8 transition-all cursor-pointer">
                                    <div
                                        class="bg-white/5 size-14 flex items-center justify-center rounded-2xl text-primary group-hover:bg-primary group-hover:text-white transition-all duration-300">
                                        <span class="material-symbols-outlined text-3xl">work</span>
                                    </div>
                                    <div class="flex flex-col gap-2">
                                        <h3 class="text-white text-xl font-bold premium-heading">BUSINESS</h3>
                                        <p class="text-gray-400 text-sm leading-relaxed">Enterprise-grade security and
                                            all-day battery endurance.</p>
                                    </div>
                                    <div
                                        class="flex items-center text-primary text-[11px] font-black uppercase tracking-widest mt-auto">
                                        Learn More <span
                                            class="material-symbols-outlined text-sm ml-2 group-hover:translate-x-2 transition-transform">arrow_forward</span>
                                    </div>
                                </div>
                                <div
                                    class="glass-card group flex flex-col gap-6 rounded-2xl p-8 transition-all cursor-pointer">
                                    <div
                                        class="bg-white/5 size-14 flex items-center justify-center rounded-2xl text-primary group-hover:bg-primary group-hover:text-white transition-all duration-300">
                                        <span class="material-symbols-outlined text-3xl">school</span>
                                    </div>
                                    <div class="flex flex-col gap-2">
                                        <h3 class="text-white text-xl font-bold premium-heading">STUDENT</h3>
                                        <p class="text-gray-400 text-sm leading-relaxed">Lightweight versatility that
                                            keeps
                                            up with your campus life.</p>
                                    </div>
                                    <div
                                        class="flex items-center text-primary text-[11px] font-black uppercase tracking-widest mt-auto">
                                        Learn More <span
                                            class="material-symbols-outlined text-sm ml-2 group-hover:translate-x-2 transition-transform">arrow_forward</span>
                                    </div>
                                </div>
                                <div
                                    class="glass-card group flex flex-col gap-6 rounded-2xl p-8 transition-all cursor-pointer">
                                    <div
                                        class="bg-white/5 size-14 flex items-center justify-center rounded-2xl text-primary group-hover:bg-primary group-hover:text-white transition-all duration-300">
                                        <span class="material-symbols-outlined text-3xl">palette</span>
                                    </div>
                                    <div class="flex flex-col gap-2">
                                        <h3 class="text-white text-xl font-bold premium-heading">CREATORS</h3>
                                        <p class="text-gray-400 text-sm leading-relaxed">Color-accurate displays and
                                            massive
                                            multi-core power.</p>
                                    </div>
                                    <div
