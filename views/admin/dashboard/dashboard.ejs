<!DOCTYPE html>
<html class="dark" lang="en">

<head>
  <meta charset="utf-8" />
  <meta content="width=device-width, initial-scale=1.0" name="viewport" />
  <title>TechKart Admin Top Performance Dashboard</title>
  <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&amp;display=swap"
    rel="stylesheet" />
  <link
    href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap"
    rel="stylesheet" />
  <!-- Add Chart.js -->
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  <script id="tailwind-config">
    tailwind.config = {
      darkMode: "class",
      theme: {
        extend: {
          colors: {
            primary: "#0055ff",
            "background-light": "#f5f6f8",
            "background-dark": "#0d0d0d",
            "card-bg": "rgba(23, 33, 54, 0.4)",
          },
          fontFamily: {
            display: ["Space Grotesk", "sans-serif"],
          },
          borderRadius: {
            DEFAULT: "0.5rem",
            lg: "1rem",
            xl: "1.5rem",
            full: "9999px",
          },
        },
      },
    };
  </script>
  <style type="text/tailwindcss">
    body {
        font-family: "Space Grotesk", sans-serif;
      }
      .glass-morphism {
        background: rgba(23, 33, 54, 0.6);
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        border: 1px solid rgba(255, 255, 255, 0.08);
      }
      .table-row-hover:hover {
        background: rgba(255, 255, 255, 0.03);
      }
      .glow-line {
        filter: drop-shadow(0 0 8px rgba(0, 85, 255, 0.5));
      }
      .high-gloss {
        background: linear-gradient(
          135deg,
          rgba(255, 255, 255, 0.05) 0%,
          rgba(255, 255, 255, 0) 100%
        );
        box-shadow: inset 0 1px 1px rgba(255, 255, 255, 0.1);
      }
      .custom-scrollbar::-webkit-scrollbar {
        width: 4px;
      }
      .custom-scrollbar::-webkit-scrollbar-track {
        background: rgba(255, 255, 255, 0.02);
      }
      .custom-scrollbar::-webkit-scrollbar-thumb {
        background: rgba(0, 85, 255, 0.3);
        border-radius: 10px;
      }
    </style>
</head>

<body class="flex min-h-screen bg-background-dark text-white">
  <%- include('../../partials/admin/sidebar') %>
    <main class="flex-1 flex flex-col relative overflow-y-auto custom-scrollbar min-w-0">
      <%- include('../../partials/admin/header') %>
        <div class="p-4 md:p-10 space-y-6 md:space-y-10">
          
          <!-- Top Cards -->
          <section class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
            <div class="glass-morphism high-gloss p-6 rounded-xl relative overflow-hidden group">
              <div class="flex justify-between items-start mb-4">
                <span class="text-xs font-bold text-slate-400 uppercase tracking-widest">Total Revenue</span>
                <span class="material-symbols-outlined text-primary/60">payments</span>
              </div>
              <div class="flex items-end gap-3">
                <h3 class="text-3xl font-bold tracking-tight">₹<%= totalRevenue ? totalRevenue.toLocaleString('en-IN') : '0' %></h3>
              </div>
              <div class="mt-6 h-12 w-full relative">
                <svg class="w-full h-full" viewBox="0 0 200 60">
                  <path class="glow-line" d="M0 50 Q 25 45, 50 35 T 100 40 T 150 20 T 200 10" fill="none" stroke="#0055ff" stroke-width="3"></path>
                </svg>
              </div>
            </div>
            
            <div class="glass-morphism high-gloss p-6 rounded-xl relative overflow-hidden">
              <div class="flex justify-between items-start mb-4">
                <span class="text-xs font-bold text-slate-400 uppercase tracking-widest">Total Orders</span>
                <span class="material-symbols-outlined text-primary/60">local_shipping</span>
              </div>
              <h3 class="text-3xl font-bold tracking-tight"><%= totalOrders || 0 %></h3>
              <p class="text-xs text-slate-500 mt-2 font-medium">Completed orders</p>
              <div class="mt-4 w-full bg-white/5 h-1.5 rounded-full overflow-hidden">
                <div class="bg-primary h-full w-full shadow-[0_0_8px_rgba(0,85,255,0.4)]"></div>
              </div>
            </div>

            <div class="glass-morphism high-gloss p-6 rounded-xl relative overflow-hidden">
              <div class="flex justify-between items-start mb-4">
                <span class="text-xs font-bold text-slate-400 uppercase tracking-widest">Total Users</span>
                <span class="material-symbols-outlined text-primary/60">group_add</span>
              </div>
              <h3 class="text-3xl font-bold tracking-tight"><%= totalUsers || 0 %></h3>
              <p class="text-xs text-slate-500 mt-2 font-medium">Registered customers</p>
              <div class="mt-4 w-full bg-white/5 h-1.5 rounded-full overflow-hidden">
                 <div class="bg-primary h-full w-full shadow-[0_0_8px_rgba(0,85,255,0.4)]"></div>
              </div>
            </div>

            <div class="glass-morphism high-gloss p-6 rounded-xl relative overflow-hidden">
              <div class="flex justify-between items-start mb-4">
                <span class="text-xs font-bold text-slate-400 uppercase tracking-widest">Products</span>
                <span class="material-symbols-outlined text-primary/60">inventory_2</span>
              </div>
              <h3 class="text-3xl font-bold tracking-tight"><%= totalProducts || 0 %></h3>
              <p class="text-xs text-slate-500 mt-2 font-medium">Active products in store</p>
              <div class="mt-4 w-full bg-white/5 h-1.5 rounded-full overflow-hidden">
                 <div class="bg-primary h-full w-full shadow-[0_0_8px_rgba(0,85,255,0.4)]"></div>
              </div>
            </div>
          </section>

          <!-- Sales Chart Section -->
          <section class="glass-morphism high-gloss rounded-2xl overflow-hidden p-6 mb-8">
            <div class="flex items-center justify-between mb-6">
              <div>
                <h3 class="font-bold tracking-tight text-lg">Sales Analytics</h3>
                <p class="text-[10px] text-slate-500 uppercase tracking-[0.2em]">Revenue Overview</p>
              </div>
              <div>
                <select id="chartFilter" class="bg-background-dark border border-white/10 rounded-lg text-sm px-4 py-2 text-white focus:outline-none focus:border-primary">
                  <option value="weekly">Weekly</option>
                  <option value="monthly" selected>Monthly</option>
                  <option value="yearly">Yearly</option>
                </select>
              </div>
            </div>
            <div class="w-full h-[400px]">
              <canvas id="salesChart"></canvas>
            </div>
          </section>

          <!-- Top 10 Lists Section -->
          <section class="grid grid-cols-1 xl:grid-cols-3 gap-8">
            
            <!-- Top 10 Products -->
            <div class="glass-morphism high-gloss rounded-2xl overflow-hidden flex flex-col min-h-[400px]">
              <div class="p-6 border-b border-white/5 flex items-center justify-between bg-white/5">
                <div>
                  <h3 class="font-bold tracking-tight text-lg">Top 10 Products</h3>
                  <p class="text-[10px] text-slate-500 uppercase tracking-[0.2em]">Best-selling by units</p>
                </div>
              </div>
              <div class="flex-1 p-6 overflow-y-auto custom-scrollbar">
                <div class="space-y-5">
                  <% if(topProducts && topProducts.length > 0) { %>
                    <% topProducts.forEach((product, index) => { %>
                      <div class="flex items-center gap-4 group">
                        <div class="text-xs font-bold text-primary/40 w-4"><%= (index + 1).toString().padStart(2, '0') %></div>
                        <div class="flex-1">
                          <div class="flex justify-between items-end mb-2">
                            <span class="text-sm font-semibold text-slate-200"><%= product.name %></span>
                            <span class="text-xs font-bold text-white"><%= product.totalQuantity %> units</span>
                          </div>
                          <div class="w-full bg-white/5 h-2.5 rounded-full overflow-hidden">
                            <!-- Calculate percentage relative to highest seller -->
                            <% const maxQty = topProducts[0].totalQuantity; const percentage = (product.totalQuantity / maxQty) * 100; %>
                            <div class="bg-primary h-full shadow-[0_0_15px_rgba(0,85,255,0.4)] rounded-full" style="width: <%= percentage %>%"></div>
                          </div>
                        </div>
                      </div>
                    <% }) %>
                  <% } else { %>
                    <p class="text-sm text-slate-500 text-center py-10">No product sales yet</p>
                  <% } %>
                </div>
              </div>
            </div>

            <!-- Top 10 Categories -->
            <div class="glass-morphism high-gloss rounded-2xl overflow-hidden flex flex-col min-h-[400px]">
              <div class="p-6 border-b border-white/5 flex items-center justify-between bg-white/5">
                <div>
                  <h3 class="font-bold tracking-tight text-lg">Top 10 Categories</h3>
                  <p class="text-[10px] text-slate-500 uppercase tracking-[0.2em]">Best-selling by units</p>
                </div>
              </div>
              <div class="flex-1 p-6 overflow-y-auto custom-scrollbar">
                <div class="space-y-5">
                  <% if(topCategories && topCategories.length > 0) { %>
                    <% topCategories.forEach((category, index) => { %>
                      <div class="flex items-center gap-4 group">
                        <div class="text-xs font-bold text-primary/40 w-4"><%= (index + 1).toString().padStart(2, '0') %></div>
                        <div class="flex-1">
                          <div class="flex justify-between items-end mb-2">
                            <span class="text-sm font-semibold text-slate-200"><%= category.name %></span>
                            <span class="text-xs font-bold text-white"><%= category.totalQuantity %> units</span>
                          </div>
                          <div class="w-full bg-white/5 h-2.5 rounded-full overflow-hidden">
                            <% const maxQty = topCategories[0].totalQuantity; const percentage = (category.totalQuantity / maxQty) * 100; %>
                            <div class="bg-emerald-500 h-full shadow-[0_0_15px_rgba(16,185,129,0.4)] rounded-full" style="width: <%= percentage %>%"></div>
                          </div>
                        </div>
                      </div>
                    <% }) %>
                  <% } else { %>
                    <p class="text-sm text-slate-500 text-center py-10">No category sales yet</p>
                  <% } %>
                </div>
              </div>
            </div>

            <!-- Top 10 Brands -->
            <div class="glass-morphism high-gloss rounded-2xl overflow-hidden flex flex-col min-h-[400px]">
              <div class="p-6 border-b border-white/5 flex items-center justify-between bg-white/5">
                <div>
                  <h3 class="font-bold tracking-tight text-lg">Top 10 Brands</h3>
                  <p class="text-[10px] text-slate-500 uppercase tracking-[0.2em]">Best-selling by units</p>
                </div>
              </div>
              <div class="flex-1 p-6 overflow-y-auto custom-scrollbar">
                <div class="space-y-5">
                  <% if(topBrands && topBrands.length > 0) { %>
                    <% topBrands.forEach((brand, index) => { %>
                      <div class="flex items-center gap-4 group">
                        <div class="text-xs font-bold text-primary/40 w-4"><%= (index + 1).toString().padStart(2, '0') %></div>
                        <div class="flex-1">
                          <div class="flex justify-between items-end mb-2">
                            <span class="text-sm font-semibold text-slate-200"><%= brand.name %></span>
                            <span class="text-xs font-bold text-white"><%= brand.totalQuantity %> units</span>
                          </div>
                          <div class="w-full bg-white/5 h-2.5 rounded-full overflow-hidden">
                            <% const maxQty = topBrands[0].totalQuantity; const percentage = (brand.totalQuantity / maxQty) * 100; %>
                            <div class="bg-amber-500 h-full shadow-[0_0_15px_rgba(245,158,11,0.4)] rounded-full" style="width: <%= percentage %>%"></div>
                          </div>
                        </div>
                      </div>
                    <% }) %>
                  <% } else { %>
                    <p class="text-sm text-slate-500 text-center py-10">No brand sales yet</p>
                  <% } %>
                </div>
              </div>
            </div>

          </section>
        </div>
    </main>

    <div class="fixed top-[-10%] left-[-10%] w-[40%] h-[40%] bg-primary/5 blur-[120px] pointer-events-none -z-10 rounded-full"></div>
    <div class="fixed bottom-[-10%] right-[-10%] w-[40%] h-[40%] bg-primary/5 blur-[120px] pointer-events-none -z-10 rounded-full"></div>

    <script src="/js/admin/dashboard/dashboard.js"></script>
</body>
</html>