<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet" />
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script src="/js/user/cartUtils.js"></script>

<header id="mainHeader"
    class="fixed top-0 z-50 w-full border-b border-white/0 bg-transparent px-4 md:px-10 py-4 transition-all duration-300">
    <div class="max-w-[1200px] mx-auto flex items-center justify-between gap-4 md:gap-8">
        <div class="flex items-center gap-4 md:gap-12 flex-1">
            <button onclick="toggleMobileMenu()" class="lg:hidden text-white hover:text-primary transition-colors">
                <span class="material-symbols-outlined text-2xl">menu</span>
            </button>
            <div class="flex items-center gap-2 text-primary">
                <div class="size-8 flex items-center justify-center">
                    <span class="material-symbols-outlined text-3xl">laptop_mac</span>
                </div>
                <h2 class="text-white text-xl md:text-2xl font-black leading-tight premium-heading">TECHKART</h2>
            </div>
            <form action="/user/shop" method="GET" class="<%= (locals.path === '/user/shop') ? 'hidden invisible border-none p-0 m-0 w-0 h-0 pointer-events-none' : 'hidden md:flex flex-col flex-1 max-w-md !h-10' %>">
                <div
                    class="flex w-full flex-1 items-stretch rounded-full h-full bg-white/5 border border-white/10 overflow-hidden focus-within:border-primary transition-colors">
                    <div class="text-gray-500 flex items-center justify-center pl-4">
                        <span class="material-symbols-outlined text-xl">search</span>
                    </div>
                    <input name="search"
                        class="form-input flex w-full min-w-0 flex-1 border-none bg-transparent focus:outline-0 focus:ring-0 h-full placeholder:text-gray-500 px-4 pl-2 text-sm font-normal text-white"
                        placeholder="Search for premium tech..." value="<%= locals.query?.search || '' %>" />
                </div>
            </form>
        </div>
        <div class="flex items-center gap-4 md:gap-8">
            <nav class="hidden lg:flex items-center gap-8">
                <% const currentPath=locals.path || '' %>
                    <a class="<%= currentPath === '/user/dashboard' || currentPath === '/' ? 'text-primary after:w-full' : 'text-gray-400 after:w-0' %> text-xs font-bold uppercase tracking-widest hover:text-primary transition-all relative py-1 after:absolute after:bottom-0 after:left-0 after:h-[2px] after:bg-primary after:transition-all after:duration-300 hover:after:w-full"
                        href="/user/dashboard">HOME</a>
                    <a class="<%= currentPath === '/user/shop' ? 'text-primary after:w-full' : 'text-gray-400 after:w-0' %> text-xs font-bold uppercase tracking-widest hover:text-primary transition-all relative py-1 after:absolute after:bottom-0 after:left-0 after:h-[2px] after:bg-primary after:transition-all after:duration-300 hover:after:w-full"
                        href="/user/shop">SHOP</a>
                    <a class="<%= currentPath === '/user/contact' ? 'text-primary after:w-full' : 'text-gray-400 after:w-0' %> text-xs font-bold uppercase tracking-widest hover:text-primary transition-all relative py-1 after:absolute after:bottom-0 after:left-0 after:h-[2px] after:bg-primary after:transition-all after:duration-300 hover:after:w-full"
                        href="/user/contact">CONTACT US</a>
                    <a class="<%= currentPath === '/user/about' ? 'text-primary after:w-full' : 'text-gray-400 after:w-0' %> text-xs font-bold uppercase tracking-widest hover:text-primary transition-all relative py-1 after:absolute after:bottom-0 after:left-0 after:h-[2px] after:bg-primary after:transition-all after:duration-300 hover:after:w-full"
                        href="/user/about">ABOUT US</a>
            </nav>
            <div class="flex items-center gap-3 md:gap-4">
                <a href="/user/wishlist"
                    class="flex items-center justify-center rounded-full h-10 w-10 bg-white/5 border border-white/10 text-white hover:bg-primary/20 hover:border-primary/50 transition-all duration-300">
                    <span class="material-symbols-outlined text-xl">favorite</span>
                </a>
                <a href="/user/cart"
                    class="flex items-center justify-center rounded-full h-10 w-10 bg-white/5 border border-white/10 text-white hover:bg-primary/20 hover:border-primary/50 transition-all duration-300 relative group">
                    <span class="material-symbols-outlined text-xl">shopping_cart</span>
                    <span id="cart-badge" class="absolute -top-1 -right-1 size-4 bg-primary text-[8px] font-black flex items-center justify-center rounded-full border border-[#0D0D0D] <%= locals.cartCount > 0 ? '' : 'hidden' %>">
                        <%= locals.cartCount || 0 %>
                    </span>
                </a>
                <% if (locals.user) { %>
                    <a href="/user/profile"
                        class="flex items-center justify-center gap-2 rounded-full h-10 px-6 bg-primary text-white text-[10px] font-black uppercase tracking-[0.15em] hover:shadow-[0_0_25px_-5px_#0055FF] hover:scale-105 transition-all duration-300">
                        <span class="material-symbols-outlined text-lg">person</span>
                        <span class="hidden xs:inline">PROFILE</span>
                    </a>
                    <% } else { %>
                        <a href="/user/login"
                            class="flex items-center justify-center gap-2 rounded-full h-10 px-6 bg-primary text-white text-[10px] font-black uppercase tracking-[0.15em] hover:shadow-[0_0_25px_-5px_#0055FF] hover:scale-105 transition-all duration-300">
                            <span class="material-symbols-outlined text-lg">person_add</span>
                            <span class="hidden xs:inline">LOG IN</span>
                        </a>
                        <% } %>
            </div>
        </div>
    </div>

</header>

<!-- Spacer to prevent content from hiding under fixed header -->
<div class="h-[73px] md:h-[81px]"></div>

<!-- Mobile Navigation Menu - Moved outside header for solid background -->
<div id="mobileMenu" class="fixed inset-0 z-[100] hidden">
    <!-- Backdrop -->
    <div onclick="toggleMobileMenu()" class="absolute inset-0 bg-[#000000]/95 backdrop-blur-md"></div>

    <!-- Drawer -->
    <div class="absolute inset-y-0 left-0 w-72 bg-[#0D0D0D] border-r border-white/10 p-6 flex flex-col gap-8 shadow-[20px_0_60px_rgba(0,0,0,0.9)] opacity-100"
        style="background-color: #0D0D0D !important;">
        <div class="flex items-center justify-between">
            <div class="flex items-center gap-2 text-primary">
                <span class="material-symbols-outlined text-3xl font-bold">laptop_mac</span>
                <h2 class="text-white text-xl font-black tracking-tighter italic">TECHKART</h2>
            </div>
            <button onclick="toggleMobileMenu()" class="text-gray-400 hover:text-white p-2">
                <span class="material-symbols-outlined text-2xl">close</span>
            </button>
        </div>

        <div class="flex flex-col gap-3">
            <p class="text-[10px] font-bold text-gray-500 uppercase tracking-[0.2em] mb-2 px-4 italic">Navigation Menu
            </p>
            <a href="/user/dashboard"
                class="flex items-center gap-4 px-4 py-3.5 rounded-xl bg-primary text-sm font-black text-white shadow-[0_10px_20px_rgba(0,85,255,0.2)]">
                <span class="material-symbols-outlined text-xl">home</span>
                HOME
            </a>
            <a href="/user/shop"
                class="flex items-center gap-4 px-4 py-3.5 rounded-xl text-sm font-bold text-gray-300 hover:text-white hover:bg-white/5 transition-all">
                <span class="material-symbols-outlined text-xl">shopping_bag</span>
                SHOP
            </a>
            <a href="/user/wishlist"
                class="flex items-center gap-4 px-4 py-3.5 rounded-xl text-sm font-bold text-gray-300 hover:text-white hover:bg-white/5 transition-all">
                <span class="material-symbols-outlined text-xl">favorite</span>
                WISHLIST
            </a>
            <a href="/user/contact"
                class="flex items-center gap-4 px-4 py-3.5 rounded-xl text-sm font-bold text-gray-300 hover:text-white hover:bg-white/5 transition-all">
                <span class="material-symbols-outlined text-xl">call</span>
                CONTACT US
            </a>
            <a href="/user/about"
                class="flex items-center gap-4 px-4 py-3.5 rounded-xl text-sm font-bold text-gray-300 hover:text-white hover:bg-white/5 transition-all">
                <span class="material-symbols-outlined text-xl">info</span>
                ABOUT US
            </a>
            <a href="/user/cart"
                class="flex items-center gap-4 px-4 py-3.5 rounded-xl text-sm font-bold text-gray-300 hover:text-white hover:bg-white/5 transition-all">
                <span class="material-symbols-outlined text-xl">shopping_cart</span>
                CART
            </a>
        </div>

        <div class="mt-auto pt-6 border-t border-white/10">
            <p class="text-[10px] font-bold text-gray-500 uppercase tracking-[0.2em] mb-4 px-4">Search Catalog</p>
            <form action="/user/shop" method="GET" class="<%= (locals.path === '/user/shop') ? 'hidden invisible' : 'relative mb-6' %>">
                <span
                    class="material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2 text-gray-500 text-lg">search</span>
                <input name="search"
                    class="w-full bg-white/5 border border-white/10 rounded-xl py-3 pl-11 pr-4 text-xs text-white focus:outline-none focus:border-primary transition-all focus:bg-white/[0.08]"
                    placeholder="Search product..." value="<%= locals.query?.search || '' %>" />
            </form>
            <div class="flex items-center justify-between px-2">
                <p class="text-[8px] text-gray-600 uppercase tracking-widest font-bold">TechKart Premium © 2024</p>
                <div class="flex gap-2">
                    <div class="size-1.5 rounded-full bg-emerald-500 animate-pulse"></div>
                    <span class="text-[8px] text-gray-500 font-bold uppercase tracking-widest">v1.2.0</span>
                </div>
            </div>
        </div>
    </div>
</div>
<script src="/js/partials/header.js"></script>