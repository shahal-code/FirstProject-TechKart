<!DOCTYPE html>
<html class="dark" lang="en">

<head>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>TechKart | Reset Password</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;900&amp;display=swap"
        rel="stylesheet" />
    <link
        href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap"
        rel="stylesheet" />
    <style>
        body {
            font-family: 'Inter', sans-serif;
            background-color: #0D0D0D;
            color: #e5e7eb;
            -webkit-font-smoothing: antialiased;
            -moz-osx-font-smoothing: grayscale;
        }

        .material-symbols-outlined {
            font-family: 'Material Symbols Outlined';
            font-weight: normal;
            font-style: normal;
            font-size: 24px;
            line-height: 1;
            letter-spacing: normal;
            text-transform: none;
            display: inline-block;
            white-space: nowrap;
            word-wrap: normal;
            direction: ltr;
            font-feature-settings: 'liga';
            -webkit-font-feature-settings: 'liga';
            -webkit-font-smoothing: antialiased;
            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
        }

        /* Autofill override to maintain dark theme consistency */
        input:-webkit-autofill,
        input:-webkit-autofill:hover,
        input:-webkit-autofill:focus,
        input:-webkit-autofill:active {
            -webkit-background-clip: text;
            -webkit-text-fill-color: white !important;
            transition: background-color 5000s ease-in-out 0s;
            box-shadow: inset 0 0 20px 20px #1A1A1A !important;
        }
    </style>
    <script src="/js/user/auth/reset-password.js"></script>
</head>

<body class="bg-[#0D0D0D] font-display text-white overflow-x-hidden min-h-screen">
    <div class="flex h-screen w-full flex-col lg:flex-row">
        <!-- Left Side: Branding -->
        <div class="relative hidden lg:flex lg:w-1/2 flex-col justify-center items-center bg-[#070b13] overflow-hidden">
            <div class="absolute inset-0 z-0 opacity-40">
                <div class="w-full h-full bg-cover bg-center"
                    style='background-image: url("https://lh3.googleusercontent.com/aida-public/AB6AXuBlnf5aHccqEycRlxUalf8vCI7t1e3PiALiuXTwOHlC2ZyRO33EELlCD9aw1QpVVmDo7ROA_GZk6EBwdVFuwqy2qiTPm6l5ZVeHhRof-cXfpH4cLAnbwZx2AhG4aswJI9Cg8oAncd8JY-xdiGDCmwtubEOA3ITdXtu_ReETFkok4-PJ2iM0-ZelpmFalDpy7hjXt2vZJSRk5Te2MnZPuA5EFvMXK48Ox_HvyOobCm7aVgQfObx_IVI7gD2K8sMhG8viI6N7-HBRozB_");'>
                </div>
            </div>
            <div class="absolute inset-0 z-10 bg-gradient-to-tr from-[#020617] via-transparent to-[#020617]/90"></div>
            <div class="relative z-20 flex flex-col items-center text-center px-12">
                <div
                    class="mb-8 flex items-center justify-center p-5 bg-[#1a2b4c]/70 rounded-xl border border-primary/20 backdrop-blur-md">
                    <span class="material-symbols-outlined text-primary text-6xl"
                        style="font-variation-settings: 'FILL' 1">bolt</span>
                </div>
                <h1 class="text-4xl md:text-5xl font-black tracking-tight mb-4 text-white">TechKart <span
                        class="text-[#0055ff]">Premium</span></h1>
                <p class="text-lg md:text-xl text-gray-400 max-w-md leading-relaxed mx-auto font-light">
                    The destination for elite hardware and next-generation computing power.
                </p>
            </div>
        </div>

        <!-- Right Side: Reset Password Form -->
        <div class="flex-1 flex flex-col bg-[#131313] min-h-screen lg:h-screen overflow-y-auto">
            <main class="flex-1 flex flex-col justify-center px-6 py-12 lg:px-24">
                <div class="max-w-[400px] w-full mx-auto">
                    <div class="mb-10">
                        <h2 class="text-3xl font-bold tracking-tight text-white mb-2">New Password</h2>
                        <p class="text-gray-400 text-sm">Create a new, strong password for your account.</p>
                        <% if (locals.message) { %>
                            <div
                                class="bg-red-500/10 border border-red-500/20 text-red-500 px-4 py-3 rounded-lg text-sm mb-4">
                                <%= message %>
                            </div>
                            <% } %>
                    </div>

                    <form action="/user/reset-password" method="POST" class="space-y-6">
                        <div class="flex flex-col gap-2">
                            <label class="text-xs font-semibold text-gray-500 uppercase px-1">New Password</label>
                            <div class="relative group">
                                <input name="password"
                                    class="w-full bg-[#1A1A1A] border border-gray-800 focus:border-[#0055ff] focus:ring-1 focus:ring-[#0055ff] rounded-2xl h-14 pl-4 pr-12 text-white placeholder:text-gray-600 transition-all font-medium outline-none"
                                    placeholder="••••••••" type="password" />
                                <button type="button"
                                    class="toggle-password absolute right-4 top-1/2 -translate-y-1/2 text-gray-600 hover:text-white transition-colors">
                                    <span class="material-symbols-outlined text-[18px]">visibility</span>
                                </button>
                            </div>
                        </div>
                        <div class="flex flex-col gap-2">
                            <label class="text-xs font-semibold text-gray-500 uppercase px-1">Confirm Password</label>
                            <div class="relative group">
                                <input name="confirmPassword"
                                    class="w-full bg-[#1A1A1A] border border-gray-800 focus:border-[#0055ff] focus:ring-1 focus:ring-[#0055ff] rounded-2xl h-14 pl-4 pr-12 text-white placeholder:text-gray-600 transition-all font-medium outline-none"
                                    placeholder="••••••••" type="password" />
                                <button type="button"
                                    class="toggle-password absolute right-4 top-1/2 -translate-y-1/2 text-gray-600 hover:text-white transition-colors">
                                    <span class="material-symbols-outlined text-[18px]">visibility</span>
                                </button>
                            </div>
                        </div>

                        <button
                            class="w-full bg-[#0055ff] hover:bg-[#0055ff]/90 text-white font-bold h-14 rounded-2xl transition-all shadow-[0_0_20px_rgba(0,85,255,0.3)] mt-2 flex items-center justify-center gap-2 text-sm"
                            type="submit">
                            Update Password
                            <span class="material-symbols-outlined text-[18px]">arrow_forward</span>
                        </button>
                    </form>

                    <div class="mt-8 pt-8 border-t border-gray-800">
                        <a href="/user/login"
                            class="flex items-center gap-2 text-gray-400 hover:text-white transition-colors text-sm font-medium w-fit">
                            <span class="material-symbols-outlined text-[18px]">arrow_back</span>
                            Back to Login
                        </a>
                    </div>
                </div>
            </main>
            <footer class="px-8 py-8 lg:px-24">
                <div class="flex justify-between items-center gap-4 text-xs">
                    <a class="text-gray-600 hover:text-gray-400 transition-colors" href="#">Privacy Policy</a>
                    <a class="text-gray-600 hover:text-gray-400 transition-colors" href="#">Terms of Service</a>
                    <a class="text-gray-600 hover:text-gray-400 transition-colors" href="#">Support</a>
                </div>
            </footer>
        </div>
    </div>
    <script src="/js/utils/password-toggle.js"></script>
</body>
</html>