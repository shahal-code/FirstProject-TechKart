                        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-10">
                            <div
                                class="glass-card group rounded-2xl overflow-hidden transition-all duration-500 hover:-translate-y-2">
                                <div class="aspect-[4/3] bg-white/[0.03] relative overflow-hidden">
