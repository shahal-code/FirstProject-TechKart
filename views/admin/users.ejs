<!DOCTYPE html>
<html class="dark" lang="en">

<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>TechKart Admin - Customers CRM</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&amp;display=swap"
        rel="stylesheet" />
    <link
        href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap"
        rel="stylesheet" />
    <script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        "primary": "#0055ff",
                        "background-light": "#f5f6f8",
                        "background-dark": "#0a0c10",
                        "card-bg": "rgba(23, 33, 54, 0.4)",
                    },
                    fontFamily: {
                        "display": ["Space Grotesk", "sans-serif"]
                    },
                    borderRadius: {
                        "DEFAULT": "0.5rem",
                        "lg": "1rem",
                        "xl": "1.5rem",
                        "full": "9999px"
                    },
                },
            },
        }
    </script>
    <style type="text/tailwindcss">
        body {
            font-family: 'Space Grotesk', sans-serif;
            @apply bg-background-dark text-white;
        }
        .glass-morphism {
            background: rgba(17, 25, 40, 0.75);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.05);
        }
        .sidebar-item-active {
            @apply bg-primary/10 text-primary border-r-2 border-primary shadow-[inset_0_0_20px_rgba(0,85,255,0.1)];
        }
        .input-field {
            @apply w-full bg-white/5 border border-white/10 rounded-lg py-2.5 px-4 text-sm focus:ring-1 focus:ring-primary focus:border-primary text-slate-200 placeholder-slate-500 transition-all outline-none;
        }
        .label-text {
            @apply text-[10px] font-bold text-slate-400 uppercase tracking-widest mb-2 block;
        }
        .custom-scrollbar::-webkit-scrollbar {
            width: 4px;
        }
        .custom-scrollbar::-webkit-scrollbar-track {
            background: transparent;
        }
        .custom-scrollbar::-webkit-scrollbar-thumb {
            background: rgba(255, 255, 255, 0.1);
            border-radius: 10px;
        }
        .status-badge {
            @apply px-3 py-1 rounded-full text-[10px] font-bold uppercase tracking-wider inline-flex items-center gap-1.5;
        }
        .tier-platinum { @apply bg-primary/20 text-primary border border-primary/30; }
        .tier-gold { @apply bg-amber-500/10 text-amber-500 border border-amber-500/20; }
        .tier-silver { @apply bg-slate-500/10 text-slate-500 border border-slate-500/20; }
        .status-active { @apply bg-emerald-500/10 text-emerald-500 border border-emerald-500/20; }
        .status-blocked { @apply bg-rose-500/10 text-rose-500 border border-rose-500/20; }
    </style>
</head>

<body class="flex min-h-screen">
    <!-- Sidebar -->
    <%- include('../partials/admin/sidebar') %>

    <main class="flex-1 flex flex-col relative overflow-y-auto custom-scrollbar min-w-0">
        <!-- Header -->
        <%- include('../partials/admin/header') %>

        <div class="p-4 md:p-10 max-w-[1600px] mx-auto w-full space-y-6 md:space-y-8">
            <!-- Stats -->
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
                <div class="bg-[#111827]/50 rounded-2xl p-6 border border-white/5">
                    <p class="text-[10px] font-bold text-slate-400 uppercase tracking-widest mb-2">Total Customers</p>
                    <div class="flex items-end justify-between">
                        <h3 class="text-3xl font-bold">12,842</h3>
                        <span
                            class="text-emerald-500 text-[10px] font-bold bg-emerald-500/10 px-2 py-0.5 rounded flex items-center gap-1">+12%</span>
                    </div>
                </div>
                <div class="bg-[#111827]/50 rounded-2xl p-6 border border-white/5">
                    <p class="text-[10px] font-bold text-slate-400 uppercase tracking-widest mb-2">New This Month</p>
                    <div class="flex items-end justify-between">
                        <h3 class="text-3xl font-bold">1,240</h3>
                        <span
                            class="text-emerald-500 text-[10px] font-bold bg-emerald-500/10 px-2 py-0.5 rounded flex items-center gap-1">+5.4%</span>
                    </div>
                </div>
                <div class="bg-[#111827]/50 rounded-2xl p-6 border border-white/5">
                    <p class="text-[10px] font-bold text-slate-400 uppercase tracking-widest mb-2">Average LTV</p>
                    <div class="flex items-end justify-between">
                        <h3 class="text-3xl font-bold">$4,280</h3>
                        <span
                            class="text-primary text-[10px] font-bold bg-primary/10 px-3 py-1 rounded-full uppercase tracking-wider">Stable</span>
                    </div>
                </div>
                <div class="bg-[#111827]/50 rounded-2xl p-6 border border-white/5">
                    <p class="text-[10px] font-bold text-slate-400 uppercase tracking-widest mb-2">Active Sessions</p>
                    <div class="flex items-end justify-between">
                        <h3 class="text-3xl font-bold">342</h3>
                        <div class="flex gap-1.5 items-end h-8">
                            <span class="w-1.5 h-3 bg-primary/40 rounded-full"></span>
                            <span class="w-1.5 h-6 bg-primary rounded-full"></span>
                            <span class="w-1.5 h-4 bg-primary/60 rounded-full"></span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Search and Filter -->
            <div class="bg-[#111827]/50 rounded-2xl p-4 flex flex-wrap items-center gap-4 border border-white/5">
                <form action="/admin/users" method="GET" class="flex-1 min-w-[300px] flex gap-4">
                    <div class="relative flex-1">
                        <span
                            class="material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2 text-slate-500 text-xl">search</span>
                        <input class="input-field pl-12 h-12" name="search" value="<%= search %>"
                            placeholder="Search by name, email, or ID..." type="text" />
                        <% if (search) { %>
                            <button type="button" onclick="window.location.href='/admin/users'"
                                class="absolute right-4 top-1/2 -translate-y-1/2 text-slate-500 hover:text-white transition-all">
                                <span class="material-symbols-outlined text-lg">close</span>
                            </button>
                            <% } %>
                    </div>
                    <button type="submit"
                        class="bg-primary hover:bg-primary/80 text-white text-[10px] font-bold px-8 h-12 rounded-lg transition-all uppercase tracking-widest">
                        Apply Filters
                    </button>
                </form>
            </div>

            <!-- Table -->
            <div class="bg-[#111827]/50 rounded-3xl overflow-x-auto border border-white/5 custom-scrollbar">
                <table class="w-full text-left border-collapse">
                    <thead>
                        <tr class="bg-white/5 border-b border-white/5">
                            <th class="px-8 py-5 text-[10px] font-bold text-slate-400 uppercase tracking-widest">
                                Customer</th>
                            <th class="px-6 py-5 text-[10px] font-bold text-slate-400 uppercase tracking-widest">Join
                                Date</th>
                            <th
                                class="px-6 py-5 text-[10px] font-bold text-slate-400 uppercase tracking-widest text-center">
                                Orders</th>
                            <th class="px-6 py-5 text-[10px] font-bold text-slate-400 uppercase tracking-widest">Total
                                Spent</th>
                            <th class="px-6 py-5 text-[10px] font-bold text-slate-400 uppercase tracking-widest">Loyalty
                                Tier</th>
                            <th class="px-6 py-5 text-[10px] font-bold text-slate-400 uppercase tracking-widest">Status
                            </th>
                            <th
                                class="px-8 py-5 text-[10px] font-bold text-slate-400 uppercase tracking-widest text-right">
                                Actions</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-white/5">
                        <% if (users && users.length> 0) { %>
                            <% users.forEach(user=> { %>
                                <tr class="hover:bg-white/5 transition-colors group">
                                    <td class="px-8 py-6">
                                        <div class="flex items-center gap-4">
                                            <div
                                                class="h-12 w-12 rounded-xl bg-primary/20 flex items-center justify-center text-primary font-bold text-base">
                                                <%= user.fullname ? user.fullname.substring(0, 2).toUpperCase() : '??'
                                                    %>
                                            </div>
                                            <div>
                                                <p class="text-sm font-bold text-slate-100">
                                                    <%= user.fullname %>
                                                </p>
                                                <p class="text-xs text-slate-500 font-medium">
                                                    <%= user.email %>
                                                </p>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="px-6 py-5">
                                        <p class="text-sm text-slate-300 font-medium">
                                            <%= new Date(user.createdAt).toLocaleDateString('en-US', { month: 'short' ,
                                                day: '2-digit' , year: 'numeric' }) %>
                                        </p>
                                    </td>
                                    <td class="px-6 py-5 text-center">
                                        <p class="text-sm font-bold text-slate-100">0</p>
                                    </td>
                                    <td class="px-6 py-5">
                                        <p class="text-sm font-bold text-primary">$0.00</p>
                                    </td>
                                    <td class="px-6 py-5">
                                        <span class="status-badge tier-platinum">Platinum</span>
                                    </td>
                                    <td class="px-6 py-5">
                                        <span
                                            class="status-badge <%= user.isBlocked ? 'status-blocked' : 'status-active' %>">
                                            <%= user.isBlocked ? 'Blocked' : 'Active' %>
                                        </span>
                                    </td>
                                    <td class="px-8 py-5 text-right">
                                        <div class="flex items-center justify-end gap-3">
                                            <button onclick="confirmBlock('<%= user._id %>', '<%= user.isBlocked %>')"
                                                class="text-[10px] font-bold uppercase tracking-widest <%= user.isBlocked ? 'text-emerald-500 hover:text-emerald-400' : 'text-rose-500 hover:text-rose-400' %> transition-all">
                                                <%= user.isBlocked ? 'Unblock' : 'Block' %>
                                            </button>
                                            <span class="text-slate-700">|</span>
                                            <button
                                                class="text-[10px] font-bold uppercase tracking-widest text-slate-400 hover:text-white transition-all">
                                                View User
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                                <% }) %>
                                    <% } else { %>
                                        <tr>
                                            <td colspan="7" class="px-8 py-10 text-center text-slate-500 italic">No
                                                customers found matching your search.</td>
                                        </tr>
                                        <% } %>
                    </tbody>
                </table>
            </div>

            <!-- Pagination -->
            <div class="flex items-center justify-between">
                <p class="text-xs text-slate-500 font-medium uppercase tracking-widest">
                    Showing <%= (page - 1) * 5 + 1 %> to <%= Math.min(page * 5, totalUsers) %> of <%= totalUsers %>
                                customers
                </p>
                <% if (totalPages> 1) { %>
                    <div class="flex items-center gap-2">
                        <a href="?page=<%= page - 1 %>&search=<%= search %>"
                            class="px-6 py-2.5 rounded-lg border border-white/10 text-slate-400 hover:bg-white/5 transition-all text-[10px] font-bold uppercase tracking-widest <%= page === 1 ? 'pointer-events-none opacity-30' : '' %>">
                            Previous
                        </a>

                        <% for(let i=1; i <=totalPages; i++) { %>
                            <a href="?page=<%= i %>&search=<%= search %>"
                                class="h-10 w-10 flex items-center justify-center rounded-lg text-[10px] font-bold transition-all <%= page === i ? 'bg-primary text-white shadow-[0_0_20px_rgba(0,85,255,0.3)]' : 'border border-white/10 text-slate-400 hover:bg-white/5' %>">
                                <%= i %>
                            </a>
                            <% } %>

                                <a href="?page=<%= page + 1 %>&search=<%= search %>"
                                    class="px-6 py-2.5 rounded-lg border border-white/10 text-slate-400 hover:bg-white/5 transition-all text-[10px] font-bold uppercase tracking-widest <%= page === totalPages ? 'pointer-events-none opacity-30' : '' %>">
                                    Next
                                </a>
                    </div>
                    <% } %>
            </div>
        </div>
    </main>

    <script>
        function confirmBlock(userId, isBlocked) {
            const action = isBlocked === 'true' ? 'Unblock' : 'Block';
            const color = isBlocked === 'true' ? '#10b981' : '#f43f5e';

            Swal.fire({
                title: `<span class="text-white">${action} User?</span>`,
                text: `Are you sure you want to ${action.toLowerCase()} this customer?`,
                icon: 'warning',
                background: '#111827',
                color: '#fff',
                showCancelButton: true,
                confirmButtonColor: color,
                cancelButtonColor: '#374151',
                confirmButtonText: `Yes, ${action}!`,
                customClass: {
                    popup: 'glass-morphism rounded-3xl',
                    confirmButton: 'rounded-xl font-bold uppercase tracking-widest text-[10px] px-6 py-3',
                    cancelButton: 'rounded-xl font-bold uppercase tracking-widest text-[10px] px-6 py-3'
                }
            }).then((result) => {
                if (result.isConfirmed) {
                    fetch(`/admin/users/${userId}/block`, {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json'
                        }
                    }).then(response => {
                        if (response.ok) {
                            window.location.reload();
                        }
                    });
                }
            });
        }
    </script>
</body>

</html>