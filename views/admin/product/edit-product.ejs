<!DOCTYPE html>
<html class="dark" lang="en">

<head>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>TechKart Admin - Edit Product</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&display=swap"
        rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap"
        rel="stylesheet" />
    <!-- Cropper.js CSS -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.6.1/cropper.min.css">
    <script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        "primary": "#0055ff",
                        "background-dark": "#0d0d0d",
                        "panel-bg": "#11151F",
                        "input-bg": "#1A1F2B"
                    },
                    fontFamily: {
                        "display": ["Space Grotesk", "sans-serif"]
                    },
                },
            },
        }
    </script>
    <style type="text/tailwindcss">
        body {
            font-family: 'Space Grotesk', sans-serif;
            background-color: #0d0d0d;
            color: #ffffff;
        }
        .form-card {
            background-color: #11151F;
            border-radius: 24px;
            padding: 2rem;
            border: 1px solid rgba(255, 255, 255, 0.05);
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
        }
        .sidebar-item-active {
            background-color: rgba(0, 85, 255, 0.1);
            color: #0055ff;
            border-right: 2px solid #0055ff;
            box-shadow: inset 0 0 20px rgba(0, 85, 255, 0.1);
        }
        .custom-scrollbar::-webkit-scrollbar {
            width: 4px;
        }
        .custom-scrollbar::-webkit-scrollbar-track {
            background: transparent;
        }
        .custom-scrollbar::-webkit-scrollbar-thumb {
            background: rgba(255, 255, 255, 0.1);
            border-radius: 10px;
        }
        .input-label {
            font-size: 11px;
            font-weight: 500;
            color: #94a3b8;
            margin-bottom: 0.5rem;
            display: block;
            margin-left: 0.25rem;
        }
        .input-field {
            background-color: #1A1F2B;
            border: none;
            border-radius: 1rem;
            padding: 0.875rem 1rem;
            font-size: 0.875rem;
            outline: none;
            width: 100%;
            color: white;
            transition: all 0.2s ease;
        }
        .input-field:focus {
            box-shadow: 0 0 0 1px #0055ff;
        }
        .input-field::placeholder {
            color: #64748b;
        }
        .input-field.input-error { border: 1px solid #f43f5e !important; box-shadow: 0 0 0 1px #f43f5e !important; }
        .field-error { color: #f43f5e; font-size: 0.75rem; margin-top: 0.375rem; display: none; }
        /* Fix native select dropdown dark background */
        select.input-field { background-color: #1A1F2B; color: #fff; }
        select.input-field option { background-color: #121620; color: #fff; }
        select.input-field optgroup { background-color: #0d1117; color: #64748b; }
        select.input-field option:hover, select.input-field option:checked { background-color: #0055ff; color: #fff; }
        .upload-zone {
            border: 1px dashed rgba(0, 85, 255, 0.3);
            border-radius: 1rem;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 3rem;
            background-color: rgba(0, 85, 255, 0.05);
            transition: background-color 0.2s ease;
            cursor: pointer;
        }
        .upload-zone:hover {
            background-color: rgba(0, 85, 255, 0.1);
        }
    </style>
</head>

<body class="flex min-h-screen bg-[#0D0D0D]">
    <%- include('../../partials/admin/sidebar') %>

        <main class="flex-1 flex flex-col relative overflow-y-auto custom-scrollbar">
            <%- include('../../partials/admin/header') %>

                <div class="p-8 lg:p-12 max-w-7xl mx-auto w-full">
                    <!-- Header Area -->
                    <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 mb-8">
                        <div>
                            <h2 class="text-3xl font-bold tracking-tight mb-1">Edit Product</h2>
                            <p class="text-sm text-slate-500 font-medium tracking-tight">Modify entry: <span
                                    class="text-primary">
                                    <%= product.name %>
                                </span></p>
                        </div>
                        <div class="flex items-center gap-4">
                            <button type="submit" form="productForm"
                                class="flex items-center gap-2 bg-primary hover:bg-primary/90 text-white px-8 py-3.5 rounded-full font-bold text-sm tracking-wide transition-all shadow-[0_4px_20px_rgba(0,85,255,0.4)]">
                                <span class="material-symbols-outlined text-sm">save</span>
                                UPDATE PRODUCT
                            </button>
                        </div>
                    </div>

                    <!-- Form section -->
                    <form id="productForm" action="/admin/product/edit/<%= product._id %>" method="POST"
                        class="grid grid-cols-1 xl:grid-cols-3 gap-8">
                        <!-- Left Column (General Information & Tech Specs) -->
                        <div class="xl:col-span-2 space-y-8">

                            <!-- General Info Card -->
                            <div class="form-card">
                                <div class="flex items-center gap-3 mb-8">
                                    <span class="material-symbols-outlined text-slate-400">info</span>
                                    <h3 class="text-lg font-bold">General Information</h3>
                                </div>

                                <div class="space-y-6">
                                    <div>
                                        <label class="input-label">Product Name</label>
                                        <input type="text" id="productName" name="name" value="<%= product.name %>"
                                            class="input-field" placeholder="e.g. TechKart Ultra X" oninput="clearError('productName')">
                                        <p id="productNameError" class="field-error"></p>
                                    </div>

                                    <div>
                                        <label class="input-label">Product Description</label>
                                        <textarea id="productDesc" name="description" rows="5"
                                            class="input-field resize-none rounded-3xl"
                                            placeholder="..." oninput="clearError('productDesc')"><%= product.description %></textarea>
                                        <p id="productDescError" class="field-error"></p>
                                    </div>

                                    <div class="grid grid-cols-2 gap-6">
                                        <div>
                                            <label class="input-label">Price (USD)</label>
                                            <div class="relative">
                                                <span
                                                    class="absolute left-4 top-1/2 -translate-y-1/2 text-slate-400 font-medium">₹</span>
                                                <input type="number" id="productPrice" name="price" step="0.01"
                                                    value="<%= product.variants && product.variants.length > 0 ? product.variants[0].price : '' %>"
                                                    class="input-field pl-8" placeholder="2499" oninput="clearError('productPrice')">
                                            </div>
                                            <p id="productPriceError" class="field-error"></p>
                                        </div>
                                        <div>
                                            <label class="input-label">Category</label>
                                             <select id="productCategory" name="category_id"
                                                class="input-field appearance-none cursor-pointer" onchange="clearError('productCategory')">
                                                <% categories.forEach(cat=> { %>
                                                    <option value="<%= cat._id %>" <%=product.category_id &&
                                                        product.category_id._id.toString()===cat._id.toString()
                                                        ? 'selected' : '' %>><%= cat.name %>
                                                    </option>
                                                    <% }) %>
                                            </select>
                                            <p id="productCategoryError" class="field-error"></p>
                                        </div>
                                    </div>

                                </div>
                            </div>

                            <div class="form-card relative">
                                <div class="flex items-center gap-3 mb-8">
                                    <h3 class="text-lg font-bold">Base Specifications</h3>
                                </div>

                                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                                    <div>
                                        <label class="input-label">Display Type</label>
                                        <input type="text" name="display" value="<%= product.specifications?.display || '' %>" 
                                            class="input-field" placeholder="e.g. 14' Liquid Retina XDR">
                                    </div>
                                    <div>
                                        <label class="input-label">Battery Rating</label>
                                        <input type="text" name="battery" value="<%= product.specifications?.battery || '' %>" 
                                            class="input-field" placeholder="e.g. 70Wh Lithium-Polymer">
                                    </div>
                                </div>
                            </div>

                        </div>

                        <!-- Right Column (Info / Tips) -->
                        <div class="space-y-8">
                            <div class="form-card bg-primary/5 border-primary/20">
                                <div class="flex items-center gap-3 mb-6">
                                    <span class="material-symbols-outlined text-primary">info</span>
                                    <h3 class="text-lg font-bold text-white">Variants Management</h3>
                                </div>
                                <p class="text-sm text-slate-400 leading-relaxed mb-6">
                                    Images, pricing, and specific technical configurations (RAM, SSD, GPU) are managed at the variant level.
                                </p>
                                <a href="/admin/product/manage-variants/<%= product._id %>" 
                                    class="flex items-center justify-center gap-2 w-full py-3 bg-white/5 hover:bg-white/10 border border-white/10 rounded-xl text-xs font-bold uppercase tracking-widest transition-all">
                                    <span class="material-symbols-outlined text-sm">layers</span>
                                    Manage Variants & Images
                                </a>
                            </div>

                            <div class="form-card">
                                <div class="flex items-center gap-3 mb-6">
                                    <span class="material-symbols-outlined text-slate-400">help</span>
                                    <h3 class="text-lg font-bold">Base Info</h3>
                                </div>
                                <p class="text-xs text-slate-500 leading-relaxed">
                                    This information is common to all variants of this product. Use this section to update general descriptions, highlights, and physical specifications.
                                </p>
                            </div>
                        </div>
                    </form>
                </div>
        </main>

        <script>
            // No longer managing images here
        </script>
        <script src="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.6.1/cropper.min.js"></script>
        <script src="/js/admin/product/edit.js"></script>
        <script src="/js/validation.js?v=2"></script>
    <!-- Cropper Modal -->
    <div id="cropperModal" class="fixed inset-0 z-[999] hidden bg-black/90 backdrop-blur-sm flex items-center justify-center p-4">
        <div class="bg-[#11151F] w-full max-w-2xl rounded-[32px] overflow-hidden border border-white/10 shadow-2xl">
            <div class="p-6 border-b border-white/5 flex items-center justify-between">
                <div>
                    <h3 class="text-xl font-bold">Crop Image</h3>
                    <p class="text-xs text-slate-500 font-medium">Square crop for product display</p>
                </div>
                <button type="button" onclick="closeCropper()" class="text-slate-400 hover:text-white transition-colors">
                    <span class="material-symbols-outlined">close</span>
                </button>
            </div>
            <div class="p-6 max-h-[60vh] overflow-hidden flex items-center justify-center bg-black/20">
                <img id="cropperImage" src="" alt="To crop" class="max-w-full">
            </div>
            <div class="p-6 border-t border-white/5 flex items-center justify-end gap-4">
                <button type="button" onclick="closeCropper()" class="px-6 py-2.5 rounded-full text-sm font-bold text-slate-400 hover:text-white transition-colors">CANCEL</button>
                <button type="button" onclick="cropImage()" class="px-8 py-2.5 rounded-full text-sm font-bold bg-[#0055ff] hover:bg-[#0044cc] text-white transition-all shadow-lg">CROP & SAVE</button>
            </div>
        </div>
    </div>
</body>

</html>