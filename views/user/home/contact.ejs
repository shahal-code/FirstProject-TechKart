<html class="dark" lang="en">

<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>Contact Us | TechKart Luxury Computing</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&amp;display=swap"
        rel="stylesheet" />
    <link
        href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap"
        rel="stylesheet" />
    <script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        "primary": "#0055FF",
                        "dark-bg": "#0D0D0D",
                        "glass-border": "rgba(255, 255, 255, 0.1)",
                    },
                    fontFamily: {
                        "display": ["Inter", "sans-serif"]
                    },
                    borderRadius: {
                        "DEFAULT": "0.25rem",
                        "lg": "0.5rem",
                        "xl": "0.75rem",
                        "2xl": "1.25rem",
                        "full": "9999px"
                    },
                },
            },
        }
    </script>
    <style type="text/tailwindcss">
        @layer base {
            body {
                font-family: 'Inter', sans-serif;
                @apply bg-[#0D0D0D] text-gray-200 antialiased;
            }
        }
        .glass-card {
            background: rgba(255, 255, 255, 0.03);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.08);
        }
        .glass-card:hover {
            border-color: #0055FF;
        }
        .premium-heading {
            letter-spacing: 0.05em;
        }
        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
        }
        .glow-icon {
            text-shadow: 0 0 15px rgba(0, 85, 255, 0.6);
        }
        .form-input-custom {
            @apply bg-white/[0.03] border-white/10 text-white rounded-xl px-6 py-4 focus:ring-1 focus:ring-primary focus:border-primary transition-all duration-300;
        }
    </style>
</head>

<body class="dark">
    <div class="relative flex h-auto min-h-screen w-full flex-col overflow-x-hidden">
        <div class="layout-container flex h-full grow flex-col">
            <%- include('../../partials/user/header') %>
                <main class="flex-1">
                    <div class="max-w-[1200px] mx-auto px-4 py-16 md:py-28">
                        <div class="flex flex-col gap-12 md:gap-20">
                            <div class="flex flex-col gap-4 text-center">
                                <h1 class="text-white text-5xl md:text-7xl font-black leading-tight premium-heading">GET
                                    IN
                                    <span class="text-primary">TOUCH</span>
                                </h1>
                                <p class="text-gray-400 text-lg md:text-xl font-medium max-w-2xl mx-auto">
                                    Whether you're seeking a custom build or priority support, our concierge team is
                                    standing by to assist you.
                                </p>
                            </div>
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-16 lg:gap-24 items-start">
                                <div class="flex flex-col gap-12">
                                    <div class="flex flex-col gap-10">
                                        <div class="flex items-start gap-6 group">
                                            <div
                                                class="bg-primary/10 p-4 rounded-2xl border border-primary/20 group-hover:bg-primary/20 transition-all duration-300">
                                                <span
                                                    class="material-symbols-outlined text-primary text-3xl glow-icon">alternate_email</span>
                                            </div>
                                            <div class="flex flex-col gap-1">
                                                <h4 class="text-white text-xs font-black uppercase tracking-[0.2em]">
                                                    Support
                                                    Email</h4>
                                                <p class="text-gray-300 text-lg font-medium">concierge@techkart.com</p>
                                                <p class="text-gray-500 text-sm">Response within 12 hours</p>
                                            </div>
                                        </div>
                                        <div class="flex items-start gap-6 group">
                                            <div
                                                class="bg-primary/10 p-4 rounded-2xl border border-primary/20 group-hover:bg-primary/20 transition-all duration-300">
                                                <span
                                                    class="material-symbols-outlined text-primary text-3xl glow-icon">location_on</span>
                                            </div>
                                            <div class="flex flex-col gap-1">
                                                <h4 class="text-white text-xs font-black uppercase tracking-[0.2em]">HQ
                                                    Location</h4>
                                                <p class="text-gray-300 text-lg font-medium">One Innovation Plaza</p>
                                                <p class="text-gray-500 text-sm">Silicon Valley, CA 94025</p>
                                            </div>
                                        </div>
                                        <div class="flex items-start gap-6 group">
                                            <div
                                                class="bg-primary/10 p-4 rounded-2xl border border-primary/20 group-hover:bg-primary/20 transition-all duration-300">
                                                <span
                                                    class="material-symbols-outlined text-primary text-3xl glow-icon">call</span>
                                            </div>
                                            <div class="flex flex-col gap-1">
                                                <h4 class="text-white text-xs font-black uppercase tracking-[0.2em]">
                                                    Global
                                                    Hotline</h4>
                                                <p class="text-gray-300 text-lg font-medium">+1 (800) TECH-KART</p>
                                                <p class="text-gray-500 text-sm">Available 24/7 for Elite Members</p>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="bg-white/[0.03] border border-white/5 p-8 rounded-2xl">
                                        <h4 class="text-white text-xs font-black uppercase tracking-[0.2em] mb-4">Follow
                                            Excellence</h4>
                                        <div class="flex gap-4">
                                            <a class="size-12 rounded-full bg-white/5 flex items-center justify-center text-gray-400 hover:text-primary hover:bg-white/10 transition-all border border-white/10"
                                                href="#">
                                                <span class="material-symbols-outlined">public</span>
                                            </a>
                                            <a class="size-12 rounded-full bg-white/5 flex items-center justify-center text-gray-400 hover:text-primary hover:bg-white/10 transition-all border border-white/10"
                                                href="#">
                                                <span class="material-symbols-outlined">share</span>
                                            </a>
                                        </div>
                                    </div>
                                </div>
                                <div class="glass-card p-8 md:p-12 rounded-[2rem] shadow-2xl relative overflow-hidden">
                                    <div
                                        class="absolute top-0 right-0 w-32 h-32 bg-primary/20 blur-[60px] rounded-full -mr-16 -mt-16">
                                    </div>
                                    <form action="https://api.web3forms.com/submit" method="POST" id="contact-form" class="flex flex-col gap-6 relative z-10">
                                        <input type="hidden" name="access_key" value="6a90cb71-80ae-4612-9d0f-c026617017bd">
                                        <input type="checkbox" name="botcheck" class="hidden" style="display: none;">
                                        
                                        <div class="flex flex-col gap-2">
                                            <label
                                                class="text-[10px] font-black text-gray-400 uppercase tracking-widest ml-1"
                                                for="name">Name</label>
                                            <input class="form-input-custom" id="name" name="name" placeholder="John Doe"
                                                type="text" required />
                                        </div>
                                        <div class="flex flex-col gap-2">
                                            <label
                                                class="text-[10px] font-black text-gray-400 uppercase tracking-widest ml-1"
                                                for="email">Email Address</label>
                                            <input class="form-input-custom" id="email" name="email" placeholder="john@example.com"
                                                type="email" required />
                                        </div>
                                        <div class="flex flex-col gap-2">
                                            <label
                                                class="text-[10px] font-black text-gray-400 uppercase tracking-widest ml-1"
                                                for="message">Message</label>
                                            <textarea class="form-input-custom min-h-[150px] resize-none" id="message" name="message"
                                                placeholder="How can we help you achieve your goals?" required></textarea>
                                        </div>
                                        <button type="submit" id="submit-btn"
                                            class="mt-4 flex w-full cursor-pointer items-center justify-center overflow-hidden rounded-full h-16 bg-primary text-white text-sm font-bold uppercase tracking-widest transition-all hover:shadow-[0_0_30px_-5px_#0055FF] hover:scale-[1.02] active:scale-[0.98]">
                                            Send Inquiry
                                        </button>
                                        <div id="form-result" class="text-center text-xs font-bold uppercase tracking-widest mt-2"></div>
                                    </form>

                                    <script>
                                        const form = document.getElementById('contact-form');
                                        const result = document.getElementById('form-result');
                                        const btn = document.getElementById('submit-btn');

                                        form.addEventListener('submit', function(e) {
                                            e.preventDefault();
                                            const formData = new FormData(form);
                                            const object = Object.fromEntries(formData);
                                            const json = JSON.stringify(object);

                                            result.innerHTML = "Sending...";
                                            result.classList.remove('text-red-500', 'text-emerald-500');
                                            result.classList.add('text-primary');
                                            btn.disabled = true;
                                            btn.style.opacity = '0.5';

                                            fetch('https://api.web3forms.com/submit', {
                                                method: 'POST',
                                                headers: {
                                                    'Content-Type': 'application/json',
                                                    'Accept': 'application/json'
                                                },
                                                body: json
                                            })
                                            .then(async (response) => {
                                                let json = await response.json();
                                                if (response.status == 200) {
                                                    result.innerHTML = "Message Sent Successfully!";
                                                    result.classList.replace('text-primary', 'text-emerald-500');
                                                    form.reset();
                                                } else {
                                                    console.log(response);
                                                    result.innerHTML = json.message;
                                                    result.classList.replace('text-primary', 'text-red-500');
                                                }
                                            })
                                            .catch(error => {
                                                console.log(error);
                                                result.innerHTML = "Something went wrong!";
                                                result.classList.replace('text-primary', 'text-red-500');
                                            })
                                            .then(function() {
                                                btn.disabled = false;
                                                btn.style.opacity = '1';
                                                setTimeout(() => {
                                                    result.innerHTML = "";
                                                }, 5000);
                                            });
                                        });
                                    </script>
                                </div>
                            </div>
                        </div>
                    </div>
                </main>
                <%- include('../../partials/user/footer') %>
        </div>
    </div>

</body>

</html>