<!DOCTYPE html>
<html class="dark" lang="en">

<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>Order Success | TechKart</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&amp;display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet" />
    <script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        "primary": "#0657f9",
                        "background-dark": "#0D0D0D",
                        "card-dark": "#161b22",
                    },
                    fontFamily: {
                        "display": ["Space Grotesk", "sans-serif"]
                    }
                },
            },
        }
    </script>
    <style>
        .glass-card {
            background: rgba(255, 255, 255, 0.03);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.05);
        }

        .success-glow {
            box-shadow: 0 0 50px rgba(6, 87, 249, 0.2);
        }

        @keyframes check-bounce {
            0% { transform: scale(0.5); opacity: 0; }
            50% { transform: scale(1.1); }
            100% { transform: scale(1); opacity: 1; }
        }

        @keyframes fade-up {
            0% { transform: translateY(20px); opacity: 0; }
            100% { transform: translateY(0); opacity: 1; }
        }

        .animate-check {
            animation: check-bounce 0.8s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
        }

        .animate-fade-up {
            opacity: 0;
            animation: fade-up 0.8s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
        }

        .delay-1 { animation-delay: 0.2s; }
        .delay-2 { animation-delay: 0.4s; }
        .delay-3 { animation-delay: 0.6s; }
    </style>
</head>

<body class="bg-background-dark font-display text-white overflow-hidden">
    <div class="min-h-screen flex items-center justify-center p-6 relative">
        <!-- Abstract Background Glows -->
        <div class="absolute top-0 left-0 w-full h-full overflow-hidden -z-10">
            <div class="absolute -top-1/4 -left-1/4 size-[500px] bg-primary/20 blur-[120px] rounded-full"></div>
            <div class="absolute -bottom-1/4 -right-1/4 size-[500px] bg-emerald-500/10 blur-[120px] rounded-full"></div>
        </div>

        <div class="max-w-xl w-full text-center space-y-10">
            <!-- Animated Success Icon -->
            <div class="relative inline-block">
                <div class="size-24 md:size-32 rounded-[2rem] md:rounded-[2.5rem] bg-primary/10 flex items-center justify-center animate-check border border-primary/20 success-glow mx-auto">
                    <span class="material-symbols-outlined text-5xl md:text-6xl text-primary font-bold">verified</span>
                </div>
                <div class="absolute -top-3 md:-top-4 -right-3 md:-right-4 size-8 md:size-10 rounded-2xl bg-emerald-500 flex items-center justify-center shadow-lg shadow-emerald-500/20 border border-emerald-400/20 animate-bounce">
                    <span class="material-symbols-outlined text-white text-base md:text-lg">check_circle</span>
                </div>
            </div>

            <!-- Content -->
            <div class="space-y-3 md:space-y-4 animate-fade-up delay-1">
                <h1 class="text-4xl md:text-5xl font-black tracking-tighter leading-none">
                    Order <span class="text-primary">Confirmed!</span>
                </h1>
                <p class="text-white/40 text-sm md:text-lg font-medium max-w-sm mx-auto leading-relaxed">
                    Thank you for choosing TechKart. Your tech is on its way to your doorstep.
                </p>
            </div>

            <!-- Order ID Card -->
            <div class="glass-card rounded-[2rem] p-5 md:p-6 max-w-sm mx-auto flex items-center justify-between group hover:bg-white/[0.05] transition-all animate-fade-up delay-2">
                <div class="text-left">
                    <p class="text-[9px] md:text-[10px] font-black text-white/20 uppercase tracking-[0.2em] mb-1">Confirmation Number</p>
                    <p class="text-lg md:text-xl font-bold tracking-widest text-primary"><%= orderId %></p>
                </div>
                <div class="size-10 md:size-12 rounded-2xl bg-white/5 flex items-center justify-center group-hover:bg-primary/20 transition-colors">
                    <span class="material-symbols-outlined text-sm md:text-base text-white/40 group-hover:text-primary transition-colors">receipt_long</span>
                </div>
            </div>

            <!-- Actions -->
            <div class="flex flex-col sm:flex-row gap-3 md:gap-4 justify-center pt-4 md:pt-6 animate-fade-up delay-3">
                <a href="/user/orders" class="bg-primary hover:bg-primary/90 text-white px-6 py-3.5 md:px-8 md:py-4 text-sm md:text-base rounded-2xl font-bold transition-all shadow-xl shadow-primary/20 flex items-center justify-center gap-2 md:gap-3 group">
                    <span class="material-symbols-outlined text-xl md:text-2xl">package_2</span>
                    Track Your Order
                </a>
                <a href="/user/shop" class="bg-white/5 hover:bg-white/10 text-white px-6 py-3.5 md:px-8 md:py-4 text-sm md:text-base rounded-2xl font-bold transition-all border border-white/10 flex items-center justify-center gap-2 md:gap-3">
                    Continue Shopping
                    <span class="material-symbols-outlined text-xl md:text-2xl">shopping_cart</span>
                </a>
            </div>

            <!-- Support Footer -->
            <p class="text-white/20 text-xs font-bold uppercase tracking-[0.3em] pt-10">
                Need help? <a href="/user/support" class="text-white hover:text-primary transition-colors underline underline-offset-4">Contact Support</a>
            </p>
        </div>
    </div>
</body>

</html>
