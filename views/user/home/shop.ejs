<!DOCTYPE html>
<html class="dark" lang="en">

<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>TechKart | Advanced Luxury Catalog</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&amp;display=swap"
        rel="stylesheet" />
    <link
        href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap"
        rel="stylesheet" />
    <script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        "primary": "#0055FF",
                        "dark-bg": "#0D0D0D",
                        "glass-border": "rgba(255, 255, 255, 0.1)",
                    },
                    fontFamily: {
                        "display": ["Inter", "sans-serif"]
                    },
                    borderRadius: {
                        "DEFAULT": "0.25rem",
                        "lg": "0.5rem",
                        "xl": "0.75rem",
                        "2xl": "1.25rem",
                        "full": "9999px"
                    },
                },
            },
        }
    </script>
    <style>
        body {
            font-family: 'Inter', sans-serif;
            background-color: #0D0D0D;
            color: #e5e7eb;
            -webkit-font-smoothing: antialiased;
            -moz-osx-font-smoothing: grayscale;
        }

        .glass-card {
            background: rgba(255, 255, 255, 0.03);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.08);
        }

        .glass-card:hover {
            background: rgba(255, 255, 255, 0.06);
            border-color: #0055FF;
        }

        .filter-section {
            background: rgba(255, 255, 255, 0.02);
            backdrop-filter: blur(8px);
            -webkit-backdrop-filter: blur(8px);
            border: 1px solid rgba(255, 255, 255, 0.05);
            padding: 1.5rem;
            border-radius: 1rem;
        }

        .premium-heading {
            letter-spacing: 0.05em;
        }

        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
        }

        input[type="checkbox"] {
            border-radius: 0.25rem;
            border-color: rgba(255, 255, 255, 0.1);
            background-color: rgba(255, 255, 255, 0.05);
            color: #0055FF;
            transition: all 150ms cubic-bezier(0.4, 0, 0.2, 1);
        }

        input[type="checkbox"]:focus {
            box-shadow: 0 0 0 1px #0D0D0D, 0 0 0 3px #0055FF;
            outline: 2px solid transparent;
            outline-offset: 2px;
        }
    </style>
</head>

<body class="dark">
    <div class="relative flex h-auto min-h-screen w-full flex-col overflow-x-hidden">
        <div class="layout-container flex h-full grow flex-col">
            <%- include('../../partials/user/header') %>
                <main class="flex-1">
                    <div class="bg-gradient-to-b from-primary/5 to-transparent border-b border-white/5">
                        <div class="max-w-[1400px] mx-auto px-4 py-12 md:py-20">
                            <div class="flex flex-col gap-4">
                                <h1 class="text-white text-4xl md:text-5xl font-black premium-heading uppercase">
                                    TechKart
                                    Shop</h1>
                                <p class="text-gray-400 text-lg max-w-xl">Advanced technical selection for the next
                                    generation of computing.</p>
                            </div>
                        </div>
                    </div>
                    <div class="max-w-[1400px] mx-auto px-4 py-12">
                        <div class="flex flex-col lg:flex-row gap-12">
                            <!-- Sidebar -->
                            <aside class="w-full lg:w-72 flex-shrink-0">
                                <div class="sticky top-24 space-y-6">
                                    <div class="filter-section">
                                        <h3
                                            class="text-white text-[10px] font-black uppercase tracking-[0.25em] mb-6 flex items-center justify-between">
                                            Categories
                                            <span class="w-8 h-px bg-primary/40"></span>
                                        </h3>
                                        <div class="space-y-4">
                                            <% categories.forEach(cat=> { %>
                                                <label class="flex items-center gap-3 group cursor-pointer">
                                                    <input class="size-4" type="checkbox" name="category"
                                                        value="<%= cat._id %>" <%= query.category === cat._id.toString() ? 'checked' : '' %> />
                                                    <span
                                                        class="text-sm font-medium text-gray-400 group-hover:text-white transition-colors">
                                                        <%= cat.name %>
                                                    </span>
                                                </label>
                                                <% }) %>
                                        </div>
                                    </div>

                                    <div class="filter-section">
                                        <h3
                                            class="text-white text-[10px] font-black uppercase tracking-[0.25em] mb-6 flex items-center justify-between">
                                            Processor
                                            <span class="w-8 h-px bg-primary/40"></span>
                                        </h3>
                                        <div class="space-y-4">
                                            <!-- Intel Group -->
                                            <div class="space-y-3">
                                                <div class="flex items-center justify-between group cursor-pointer" onclick="toggleProcessorGroup('intel-sub')">
                                                    <div class="flex items-center gap-3">
                                                        <div class="size-2 rounded-full bg-primary/40 group-hover:bg-primary transition-colors"></div>
                                                        <span class="text-sm font-bold text-gray-300 group-hover:text-white uppercase tracking-wider">Intel Core</span>
                                                    </div>
                                                    <span id="intel-sub-icon" class="material-symbols-outlined text-gray-500 group-hover:text-white transition-transform duration-300">keyboard_arrow_down</span>
                                                </div>
                                                <div id="intel-sub" class="ml-5 space-y-3 hidden border-l border-white/5 pl-4 py-1">
                                                    <label class="flex items-center gap-3 group cursor-pointer">
                                                        <input class="size-3.5" type="checkbox" name="processor" value="i3" <%= query.processor === 'i3' ? 'checked' : '' %> />
                                                        <span class="text-xs font-medium text-gray-400 group-hover:text-white transition-colors">Core i3</span>
                                                    </label>
                                                    <label class="flex items-center gap-3 group cursor-pointer">
                                                        <input class="size-3.5" type="checkbox" name="processor" value="i5" <%= query.processor === 'i5' ? 'checked' : '' %> />
                                                        <span class="text-xs font-medium text-gray-400 group-hover:text-white transition-colors">Core i5</span>
                                                    </label>
                                                    <label class="flex items-center gap-3 group cursor-pointer">
                                                        <input class="size-3.5" type="checkbox" name="processor" value="i7" <%= query.processor === 'i7' ? 'checked' : '' %> />
                                                        <span class="text-xs font-medium text-gray-400 group-hover:text-white transition-colors">Core i7</span>
                                                    </label>
                                                    <label class="flex items-center gap-3 group cursor-pointer">
                                                        <input class="size-3.5" type="checkbox" name="processor" value="i9" <%= query.processor === 'i9' ? 'checked' : '' %> />
                                                        <span class="text-xs font-medium text-gray-400 group-hover:text-white transition-colors">Core i9</span>
                                                    </label>
                                                </div>
                                            </div>

                                            <!-- AMD Group -->
                                            <div class="space-y-3">
                                                <div class="flex items-center justify-between group cursor-pointer" onclick="toggleProcessorGroup('amd-sub')">
                                                    <div class="flex items-center gap-3">
                                                        <div class="size-2 rounded-full bg-primary/40 group-hover:bg-primary transition-colors"></div>
                                                        <span class="text-sm font-bold text-gray-300 group-hover:text-white uppercase tracking-wider">AMD Ryzen</span>
                                                    </div>
                                                    <span id="amd-sub-icon" class="material-symbols-outlined text-gray-500 group-hover:text-white transition-transform duration-300">keyboard_arrow_down</span>
                                                </div>
                                                <div id="amd-sub" class="ml-5 space-y-3 hidden border-l border-white/5 pl-4 py-1">
                                                    <label class="flex items-center gap-3 group cursor-pointer">
                                                        <input class="size-3.5" type="checkbox" name="processor" value="Ryzen 5" <%= query.processor === 'Ryzen 5' ? 'checked' : '' %> />
                                                        <span class="text-xs font-medium text-gray-400 group-hover:text-white transition-colors">Ryzen 5</span>
                                                    </label>
                                                    <label class="flex items-center gap-3 group cursor-pointer">
                                                        <input class="size-3.5" type="checkbox" name="processor" value="Ryzen 7" <%= query.processor === 'Ryzen 7' ? 'checked' : '' %> />
                                                        <span class="text-xs font-medium text-gray-400 group-hover:text-white transition-colors">Ryzen 7</span>
                                                    </label>
                                                    <label class="flex items-center gap-3 group cursor-pointer">
                                                        <input class="size-3.5" type="checkbox" name="processor" value="Ryzen 9" <%= query.processor === 'Ryzen 9' ? 'checked' : '' %> />
                                                        <span class="text-xs font-medium text-gray-400 group-hover:text-white transition-colors">Ryzen 9</span>
                                                    </label>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="filter-section">
                                        <h3
                                            class="text-white text-[10px] font-black uppercase tracking-[0.25em] mb-6 flex items-center justify-between">
                                            RAM Capacity
                                            <span class="w-8 h-px bg-primary/40"></span>
                                        </h3>
                                        <div class="space-y-4">
                                            <label class="flex items-center gap-3 group cursor-pointer">
                                                <input class="size-4" type="checkbox" />
                                                <span
                                                    class="text-sm font-medium text-gray-400 group-hover:text-white transition-colors">64GB</span>
                                            </label>
                                            <label class="flex items-center gap-3 group cursor-pointer">
                                                <input class="size-4" type="checkbox" />
                                                <span
                                                    class="text-sm font-medium text-gray-400 group-hover:text-white transition-colors">32GB</span>
                                            </label>
                                            <label class="flex items-center gap-3 group cursor-pointer">
                                                <input class="size-4" type="checkbox" />
                                                <span
                                                    class="text-sm font-medium text-gray-400 group-hover:text-white transition-colors">16GB</span>
                                            </label>
                                            <label class="flex items-center gap-3 group cursor-pointer">
                                                <input class="size-4" type="checkbox" />
                                                <span
                                                    class="text-sm font-medium text-gray-400 group-hover:text-white transition-colors">8GB</span>
                                            </label>
                                        </div>
                                    </div>

                                    <div class="filter-section">
                                        <h3
                                            class="text-white text-[10px] font-black uppercase tracking-[0.25em] mb-6 flex items-center justify-between">
                                            Price Range
                                            <span class="w-8 h-px bg-primary/40"></span>
                                        </h3>
                                        <div class="space-y-4">
                                            <label class="flex items-center gap-3 group cursor-pointer">
                                                <input
                                                    class="size-4 rounded-full border-white/10 bg-white/5 text-primary focus:ring-primary"
                                                    name="price" type="radio" value="under1000" <%= query.price === 'under1000' ? 'checked' : '' %> />
                                                <span
                                                    class="text-sm font-medium text-gray-400 group-hover:text-white transition-colors">Under
                                                    $1,000</span>
                                            </label>
                                            <label class="flex items-center gap-3 group cursor-pointer">
                                                <input
                                                    class="size-4 rounded-full border-white/10 bg-white/5 text-primary focus:ring-primary"
                                                    name="price" type="radio" value="1000-2000" <%= query.price === '1000-2000' ? 'checked' : '' %> />
                                                <span
                                                    class="text-sm font-medium text-gray-400 group-hover:text-white transition-colors">$1,000
                                                    - $2,000</span>
                                            </label>
                                            <label class="flex items-center gap-3 group cursor-pointer">
                                                <input
                                                    class="size-4 rounded-full border-white/10 bg-white/5 text-primary focus:ring-primary"
                                                    name="price" type="radio" value="over2000" <%= query.price === 'over2000' ? 'checked' : '' %> />
                                                <span
                                                    class="text-sm font-medium text-gray-400 group-hover:text-white transition-colors">Over
                                                    $2,000</span>
                                            </label>
                                        </div>
                                        <div class="mt-8">
                                            <div
                                                class="text-[9px] font-bold text-gray-500 uppercase tracking-widest mb-3">
                                                Custom Range</div>
                                            <input
                                                class="w-full h-1 bg-white/10 rounded-lg appearance-none cursor-pointer accent-primary"
                                                max="5000" min="0" type="range" />
                                            <div class="flex justify-between mt-2">
                                                <span class="text-[10px] text-gray-500 font-bold">$0</span>
                                                <span class="text-[10px] text-gray-500 font-bold">$5k+</span>
                                            </div>
                                        </div>
                                    </div>

                                    <button
                                        class="w-full py-4 bg-primary text-white text-[10px] font-black uppercase tracking-[0.2em] rounded-xl hover:shadow-[0_0_25px_-5px_#0055FF] transition-all duration-300">
                                        Apply All Filters
                                    </button>
                                </div>
                            </aside>

                            <!-- Product Grid Section -->
                            <div class="flex-1">
                                <div
                                    class="flex flex-wrap items-center justify-between gap-6 mb-10 pb-6 border-b border-white/5">
                                    <div class="flex items-center gap-4">
                                        <% if (query.search || query.category) { %>
                                            <span class="text-xs font-bold text-gray-500 uppercase tracking-widest">Active Filters:</span>
                                            <div class="flex flex-wrap gap-2">
                                                <% if (query.search) { %>
                                                    <div class="px-3 py-1 bg-primary/10 border border-primary/20 rounded-full text-[10px] font-bold text-primary uppercase flex items-center gap-2">
                                                        Search: <%= query.search %>
                                                        <a href="/user/shop?<%= new URLSearchParams({...query, search: '', page: 1}).toString() %>" class="material-symbols-outlined text-xs cursor-pointer">close</a>
                                                    </div>
                                                <% } %>
                                                
                                                <% if (query.category) { %>
                                                    <% const activeCat = categories.find(c => c._id.toString() === query.category) %>
                                                    <% if (activeCat) { %>
                                                        <div class="px-3 py-1 bg-primary/10 border border-primary/20 rounded-full text-[10px] font-bold text-primary uppercase flex items-center gap-2">
                                                            <%= activeCat.name %>
                                                            <a href="/user/shop?<%= new URLSearchParams({...query, category: '', page: 1}).toString() %>" class="material-symbols-outlined text-xs cursor-pointer">close</a>
                                                        </div>
                                                    <% } %>
                                                <% } %>

                                                <a href="/user/shop" class="text-[10px] font-bold text-gray-500 hover:text-white uppercase tracking-widest ml-2 underline">Clear All</a>
                                            </div>
                                        <% } else { %>
                                            <span class="text-xs font-bold text-gray-500 uppercase tracking-widest">Showing all products</span>
                                        <% } %>
                                    </div>
                                    <div class="flex items-center gap-4">
                                        <span class="text-xs font-bold text-gray-500 uppercase tracking-widest">Sort
                                            By:</span>
                                        <!-- Add id="sortSelect" to your select tag -->
                                        <select id="sortSelect" class="...">
                                            <option value="" <%=!query.sort ? 'selected' : '' %>>Featured</option>
                                            <option value="priceLow" <%=query.sort==='priceLow' ? 'selected' : '' %>
                                                >Price: Low to High</option>
                                            <option value="priceHigh" <%=query.sort==='priceHigh' ? 'selected' : '' %>
                                                >Price: High to Low</option>
                                            <option value="aa" <%=query.sort==='aa' ? 'selected' : '' %>>A - Z</option>
                                            <option value="zz" <%=query.sort==='zz' ? 'selected' : '' %>>Z - A</option>
                                        </select>

                                    </div>
                                </div>

                                <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-8">
                                    <% if (products && products.length> 0) { %>
                                        <% products.forEach(product=> { %>
                                            <div
                                                class="glass-card group rounded-2xl overflow-hidden transition-all duration-500 hover:-translate-y-2">
                                                <a href="/user/product/<%= product._id %>" class="aspect-[4/3] bg-white/[0.03] relative overflow-hidden block">
                                                    <img src="<%= product.images[0] %>"
                                                        class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110 opacity-90" />
                                                </a>
                                                <div class="p-8">
                                                    <div class="flex justify-between items-start mb-3">
                                                        <a href="/user/product/<%= product._id %>">
                                                            <h3
                                                                class="text-white text-2xl font-black premium-heading uppercase hover:text-primary transition-colors">
                                                                <%= product.name %>
                                                            </h3>
                                                        </a>
                                                        <span class="text-primary font-bold text-2xl">$<%=
                                                                product.variants[0].price %></span>
                                                    </div>
                                                    <p class="text-gray-400 text-sm mb-8 leading-relaxed">
                                                        <%= product.description %>
                                                    </p>
                                                    <button
                                                        class="w-full flex items-center justify-center gap-3 bg-white text-black font-black text-xs uppercase tracking-widest py-4 rounded-full hover:bg-primary hover:text-white transition-all duration-300">
                                                        <span
                                                            class="material-symbols-outlined text-lg">add_shopping_cart</span>
                                                        Add to Cart
                                                    </button>
                                                </div>
                                            </div>
                                            <% }) %>
                                                <% } else { %>
                                                    <div class="col-span-full text-center py-20">
                                                        <p class="text-gray-500 font-bold uppercase tracking-widest">No
                                                            products found</p>
                                                    </div>
                                                    <% } %>
                                </div>

                                <!-- Pagination -->
                                <div class="flex justify-center mt-20 gap-2">
                                    <% if (currentPage > 1) { %>
                                        <a href="/user/shop?page=<%= currentPage - 1 %><%= query.sort ? '&sort=' + query.sort : '' %><%= query.category ? '&category=' + query.category : '' %><%= query.search ? '&search=' + query.search : '' %>"
                                            class="size-12 flex items-center justify-center rounded-full border border-white/10 text-white hover:border-primary hover:text-primary transition-all">
                                            <span class="material-symbols-outlined">chevron_left</span>
                                        </a>
                                    <% } %>

                                    <% for(let i = 1; i <= totalPages; i++) { %>
                                        <a href="/user/shop?page=<%= i %><%= query.sort ? '&sort=' + query.sort : '' %><%= query.category ? '&category=' + query.category : '' %><%= query.search ? '&search=' + query.search : '' %>"
                                            class="size-12 flex items-center justify-center rounded-full <%= currentPage == i ? 'bg-primary text-white font-bold' : 'border border-white/10 text-white font-bold hover:border-primary hover:text-primary' %> text-xs">
                                            <%= i %>
                                        </a>
                                    <% } %>

                                    <% if (currentPage < totalPages) { %>
                                        <a href="/user/shop?page=<%= parseInt(currentPage) + 1 %><%= query.sort ? '&sort=' + query.sort : '' %><%= query.category ? '&category=' + query.category : '' %><%= query.search ? '&search=' + query.search : '' %>"
                                            class="size-12 flex items-center justify-center rounded-full border border-white/10 text-white hover:border-primary hover:text-primary transition-all">
                                            <span class="material-symbols-outlined">chevron_right</span>
                                        </a>
                                    <% } %>
                                </div>
                            </div>
                        </div>
                    </div>
                </main>
                <%- include('../../partials/user/footer') %>
        </div>
    </div>
    <script src="/js/shop.js"></script>

</body>

</html>