<!DOCTYPE html>
<html class="dark" lang="en">

<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>TechKart | Power for Every Passion</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&amp;display=swap"
        rel="stylesheet" />
    <link
        href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap"
        rel="stylesheet" />
    <script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        "primary": "#0055FF",
                        "dark-bg": "#0D0D0D",
                        "glass-border": "rgba(255, 255, 255, 0.1)",
                    },
                    fontFamily: {
                        "display": ["Inter", "sans-serif"]
                    },
                    borderRadius: {
                        "DEFAULT": "0.25rem",
                        "lg": "0.5rem",
                        "xl": "0.75rem",
                        "2xl": "1.25rem",
                        "full": "9999px"
                    },
                },
            },
        }
    </script>
    <style type="text/tailwindcss">
        @layer base {
            body {
                font-family: 'Inter', sans-serif;
                @apply bg-[#0D0D0D] text-gray-200 antialiased;
            }
        }
        .glass-card {
            background: rgba(255, 255, 255, 0.03);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.08);
        }
        .glass-card:hover {
            background: rgba(255, 255, 255, 0.06);
            border-color: #0055FF;
        }
        .premium-heading {
            letter-spacing: 0.05em;
        }
        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
        }
    </style>
</head>

<body class="dark">
    <div class="relative flex h-auto min-h-screen w-full flex-col overflow-x-hidden">
        <div class="layout-container flex h-full grow flex-col">
            <%- include('../../partials/user/header') %>
                <main class="flex-1">
                    <div class="max-w-[1200px] mx-auto px-4 py-16 md:py-32">
                        <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
                            <div class="flex flex-col gap-8">
                                <div class="flex flex-col gap-6">
                                    <div
                                        class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-primary/10 border border-primary/20 w-fit">
                                        <span class="size-2 rounded-full bg-primary animate-pulse"></span>
                                        <span class="text-primary text-[10px] font-bold uppercase tracking-widest">Next
                                            Generation Computing</span>
                                    </div>
                                    <h1
                                        class="text-white text-5xl md:text-7xl font-black leading-[1.05] premium-heading uppercase">
                                        Power for Every <br /><span class="text-primary">Passion</span>
                                    </h1>
                                    <p class="text-gray-400 text-lg md:text-xl font-medium max-w-lg leading-relaxed">
                                        Experience the pinnacle of engineering. We bridge the gap between raw
                                        performance and minimalist luxury.
                                    </p>
                                </div>
                                <div class="flex flex-wrap gap-5">
                                    <button onclick="window.location.href='/user/shop'"
                                        class="flex min-w-[200px] cursor-pointer items-center justify-center overflow-hidden rounded-full h-14 px-8 bg-primary text-white text-sm font-bold uppercase tracking-widest transition-all hover:shadow-[0_0_30px_-5px_#0055FF] hover:scale-105">
                                        Shop All Laptops
                                    </button>
                                    <button
                                        class="flex min-w-[200px] cursor-pointer items-center justify-center overflow-hidden rounded-full h-14 px-8 border border-white/20 text-white text-sm font-bold uppercase tracking-widest hover:bg-white/5 transition-all">
                                        Explore Lineup
                                    </button>
                                </div>
                            </div>
                            <div class="relative mt-12 lg:mt-0">
                                <div class="relative z-10 w-full aspect-square bg-center bg-cover bg-no-repeat rounded-3xl shadow-2xl border border-white/10"
                                    style='background-image: url("https://lh3.googleusercontent.com/aida-public/AB6AXuC6dimibt_t4FisiP5Li4TwUc_V7o7qcrtwkIQWa8aaIRmbTqrbeTkv43wL7sY4IT63Ivfcty31ooifdC7zAQjTdUbpYK-hmvkWMCDExuqIxqNPtK22LW64rGicjKkBVepPHCWtBGZkDhUlHpvNB_oAXciUA-rRWSjf3jGwx5zgXnzuDZ3s5faZFQB3tyZpJQaaDUC_MASzmQZKwBAClE_LdUOwYnKT8me7Ok7Cw1YMybK6sI0FudHDHav83nRj76qnczC7HE1DchTC");'>
                                </div>
                                <div
                                    class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[140%] h-[140%] bg-primary/15 blur-[120px] rounded-full -z-10 animate-pulse">
                                </div>

                                <!-- Floating Card -->
                                <div
                                    class="absolute -bottom-8 -left-8 z-20 glass-card p-6 rounded-2xl shadow-2xl hidden md:block min-w-[240px]">
                                    <div class="flex items-center gap-4">
                                        <div
                                            class="bg-primary p-3 rounded-xl shadow-[0_0_20px_rgba(0,85,255,0.4)] flex items-center justify-center">
                                            <span class="material-symbols-outlined text-white text-2xl">bolt</span>
                                        </div>
                                        <div>
                                            <p
                                                class="text-[10px] font-black text-primary uppercase tracking-[0.2em] mb-0.5">
                                                ULTRA-CORE GEN 3</p>
                                            <p class="text-sm text-white font-bold">Unrivaled Processing</p>
                                        </div>
                                    </div>
                                </div>

                                <!-- Floating badge -->
                                <div
                                    class="absolute -top-6 -right-6 z-20 glass-card p-4 rounded-xl shadow-2xl hidden lg:block backdrop-blur-md">
                                    <div class="flex items-center gap-3">
                                        <span class="material-symbols-outlined text-emerald-500">check_circle</span>
                                        <span class="text-[10px] text-white font-bold uppercase tracking-widest">In
                                            Stock &
                                            Ready to Ship</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <% if (typeof offers !== 'undefined' && offers.length > 0) { %>
                        <div class="max-w-[1200px] mx-auto px-4 pb-24">
                            <div class="flex items-center justify-between mb-12">
                                <h2 class="text-white text-3xl font-black premium-heading uppercase flex items-center gap-3">
                                    <span class="material-symbols-outlined text-rose-500 text-4xl">local_offer</span>
                                    Exclusive Offers
                                </h2>
                            </div>
                            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                                <% offers.forEach(offer => { %>
                                    <div class="glass-card rounded-2xl p-8 relative overflow-hidden group border-rose-500/10 hover:border-rose-500/30 transition-all">
                                        <div class="absolute -right-10 -top-10 w-32 h-32 bg-rose-500/10 rounded-full blur-2xl group-hover:bg-rose-500/20 transition-all"></div>
                                        <div class="relative z-10 flex flex-col h-full">
                                            <div class="flex items-center gap-3 mb-4">
                                                <span class="px-3 py-1 rounded-full bg-rose-500/10 text-rose-500 text-[10px] font-black uppercase tracking-widest border border-rose-500/20">
                                                    <%= offer.offerType %> Offer
                                                </span>
                                                <span class="text-white/40 text-[10px] font-bold uppercase tracking-widest">
                                                    Valid till <%= new Date(offer.endDate).toLocaleDateString() %>
                                                </span>
                                            </div>
                                            <h3 class="text-white text-2xl font-black uppercase mb-2 group-hover:text-rose-500 transition-colors"><%= offer.name %></h3>
                                            <p class="text-gray-400 text-sm mb-6 flex-1"><%= offer.description || 'Grab this amazing offer while it lasts!' %></p>
                                            
                                            <div class="flex items-end justify-between mt-auto">
                                                <div>
                                                    <span class="text-rose-500 text-3xl font-black">
                                                        <%= offer.discountType === 'percentage' ? offer.discountValue + '%' : '₹' + offer.discountValue %>
                                                    </span>
                                                    <span class="text-white/40 text-[10px] font-bold uppercase tracking-widest block mt-1">Discount</span>
                                                </div>
                                                <a href="/user/shop" class="flex items-center justify-center size-10 rounded-full bg-white/5 hover:bg-rose-500 hover:text-white transition-all text-white/60">
                                                    <span class="material-symbols-outlined text-xl">arrow_forward</span>
                                                </a>
                                            </div>
                                        </div>
                                    </div>
                                <% }) %>
                            </div>
                        </div>
                    <% } %>

                    <div class="bg-white/[0.02] py-24 border-y border-white/5">
                        <div class="max-w-[1200px] mx-auto px-4">
                            <div class="mb-16 text-center">
                                <h2 class="text-white text-4xl font-black premium-heading uppercase mb-4">Choose Your
                                    Path
                                </h2>
                                <div class="h-1 w-20 bg-primary mx-auto rounded-full"></div>
                            </div>
                            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
                                <% if (typeof categories !=='undefined' && categories.length> 0) { %>
                                    <% const iconMap={ 'gaming' : 'sports_esports' , 'business' : 'work' , 'student'
                                        : 'school' , 'creator' : 'palette' , 'professional' : 'work' }; %>
                                        <% categories.forEach(category=> {
                                            const lowerName = category.name.toLowerCase();
                                            let icon = 'devices';
                                            for (const [key, val] of Object.entries(iconMap)) {
                                            if (lowerName.includes(key)) {
                                            icon = val;
                                            break;
                                            }
                                            }
                                            %>
                                            <div onclick="window.location.href='/user/shop?category=<%= category._id %>'"
                                                class="glass-card group flex flex-col gap-6 rounded-2xl p-8 transition-all cursor-pointer">
                                                <div
                                                    class="bg-white/5 size-14 flex items-center justify-center rounded-2xl text-primary group-hover:bg-primary group-hover:text-white transition-all duration-300">
                                                    <span class="material-symbols-outlined text-3xl">
                                                        <%= icon %>
                                                    </span>
                                                </div>
                                                <div class="flex flex-col gap-2">
                                                    <h3 class="text-white text-xl font-bold premium-heading uppercase">
                                                        <%= category.name %>
                                                    </h3>
                                                    <p class="text-gray-400 text-sm leading-relaxed line-clamp-2">
                                                        <%= category.description %>
                                                    </p>
                                                </div>
                                                <div
                                                    class="flex items-center text-primary text-[11px] font-black uppercase tracking-widest mt-auto">
                                                    Learn More <span
                                                        class="material-symbols-outlined text-sm ml-2 group-hover:translate-x-2 transition-transform">arrow_forward</span>
                                                </div>
                                            </div>
                                            <% }) %>
                                                <% } %>
                            </div>
                        </div>
                    </div>

                    <div class="max-w-[1200px] mx-auto px-4 py-24">
                        <div class="flex items-center justify-between mb-16">
                            <h2 class="text-white text-4xl font-black premium-heading uppercase">Current Favorites</h2>
                            <a class="text-primary font-bold text-xs uppercase tracking-[0.2em] border-b-2 border-primary pb-1"
                                href="/user/shop">See All</a>
                        </div>
                        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-10">
                            <% products.forEach(product=> { %>
                                <div
                                    class="glass-card group rounded-2xl overflow-hidden transition-all duration-500 hover:-translate-y-2">
                                    <a href="/user/product/<%= product._id %>"
                                        class="aspect-[4/3] bg-white/[0.03] relative overflow-hidden block">
                                        <% const cardVariant = product.variants.find(v => v.stock > 0) || product.variants[0]; %>
                                        <img src="<%= (product.variants && product.variants.length > 0 && cardVariant.images) ? cardVariant.images[0] : (product.images ? product.images[0] : '/img/placeholder.jpg') %>"
                                            class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110 opacity-90" />
                                        <% if (product.variants.every(v => v.stock <= 0)) { %>
                                            <div
                                                class="absolute inset-0 flex items-center justify-center bg-black/40 backdrop-blur-[2px]">
                                                <span
                                                    class="px-6 py-2 bg-rose-500 text-white text-[10px] font-black uppercase tracking-[0.3em] rounded-full shadow-lg">Sold
                                                    Out</span>
                                            </div>
                                            <% } %>
                                                <button
                                                    onclick="toggleWishlist(event, '<%= product._id %>', '<%= product.variants[0]?._id %>')"
                                                    class="absolute top-4 right-4 z-10 size-10 rounded-full bg-black/40 backdrop-blur-md flex items-center justify-center text-white hover:bg-primary transition-all duration-300">
                                                    <span class="material-symbols-outlined text-xl"
                                                        style="<%= (wishlistProductIds && wishlistProductIds.includes(product._id.toString())) ? 'font-variation-settings: \'FILL\' 1' : '' %>">favorite</span>
                                                </button>
                                    </a>
                                    <div class="p-8">
                                        <div class="flex justify-between items-start mb-3">
                                            <a href="/user/product/<%= product._id %>">
                                                <h3
                                                    class="text-white text-2xl font-black premium-heading uppercase hover:text-primary transition-colors">
                                                    <%= product.name %>
                                                </h3>
                                            </a>
                                            <div class="flex items-center gap-2">
                                                <% if (product.variants[0]?.originalPrice && product.variants[0]?.originalPrice > product.variants[0]?.price) { %>
                                                    <span class="text-gray-500 line-through text-sm">₹<%= product.variants[0]?.originalPrice %></span>
                                                <% } %>
                                                <span class="text-primary font-bold text-2xl">₹<%= product.variants[0]?.price || '0' %></span>
                                            </div>
                                        </div>
                                        <p class="text-gray-400 text-sm mb-8 leading-relaxed line-clamp-2">
                                            <%= product.description %>
                                        </p>
                                        <button
                                            onclick="addToCart('<%= product._id %>', '<%= product.variants[0]?._id %>')"
                                            class="w-full flex items-center justify-center gap-3 bg-white text-black font-black text-xs uppercase tracking-widest py-4 rounded-full hover:bg-primary hover:text-white transition-all duration-300">
                                            <span class="material-symbols-outlined text-lg">add_shopping_cart</span>
                                            Add to Cart
                                        </button>
                                    </div>
                                </div>
                                <% }) %>
                        </div>
                    </div>
                </main>
                <%- include('../../partials/user/footer') %>
        </div>
    </div>
    <script src="/js/user/home/dashboard.js"></script>
</body>

</html>