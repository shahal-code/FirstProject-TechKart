                    </div>
                    <div class="text-lg font-bold">₹107,000</div>
                    <div class="text-[10px] text-slate-500 font-bold">+2.4%</div>
                  </div>
                  <div class="p-4 bg-white/5 rounded-xl border border-white/5">
                    <div class="flex items-center gap-2 mb-1">
                      <div class="w-2 h-2 rounded-full bg-white/20"></div>
                      <span class="text-[10px] font-bold uppercase tracking-wider text-slate-400">Student</span>
                    </div>
                    <div class="text-lg font-bold">₹85,600</div>
