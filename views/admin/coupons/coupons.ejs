<!DOCTYPE html>
<html class="dark" lang="en">

<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>TechKart Admin - Coupons</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&display=swap"
        rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap"
        rel="stylesheet" />
    <script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        "primary": "#0055ff",
                        "background-dark": "#0d0d0d",
                        "card-bg": "#121620"
                    },
                    fontFamily: {
                        "display": ["Space Grotesk", "sans-serif"]
                    },
                },
            },
        }
    </script>
    <style type="text/tailwindcss">
        body {
            font-family: 'Space Grotesk', sans-serif;
            @apply bg-background-dark text-white;
        }
        .glass-morphism {
            background: rgba(23, 33, 54, 0.4);
            border: 1px solid rgba(255, 255, 255, 0.05);
        }
        .sidebar-item-active {
            @apply bg-primary/10 text-primary border-r-2 border-primary shadow-[inset_0_0_20px_rgba(0,85,255,0.1)];
        }
        .custom-scrollbar::-webkit-scrollbar {
            width: 4px;
        }
        .custom-scrollbar::-webkit-scrollbar-track {
            background: transparent;
        }
        .custom-scrollbar::-webkit-scrollbar-thumb {
            background: rgba(255, 255, 255, 0.1);
            border-radius: 10px;
        }
    </style>
</head>

<body class="flex min-h-screen bg-[#0D0D0D]">
    <%- include('../../partials/admin/sidebar') %>

    <main class="flex-1 flex flex-col relative overflow-y-auto custom-scrollbar">
        <%- include('../../partials/admin/header') %>

        <div class="p-8 lg:p-12 space-y-8">
            <!-- Header Area -->
            <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
                <div>
                    <h2 class="text-3xl font-bold tracking-tight mb-1">Coupons & Discounts</h2>
                    <p class="text-sm text-slate-500 font-medium">Manage promotional campaigns & offers</p>
                </div>
            </div>

            <!-- Table Section -->
            <section class="glass-morphism rounded-2xl overflow-hidden shadow-2xl">
                <!-- Toolbar -->
                <div class="p-6 border-b border-white/5 flex flex-wrap items-center justify-between gap-4">
                    <div class="relative flex-1 max-w-sm">
                        <span class="material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2 text-slate-500 text-[18px]">search</span>
                        <input type="text" id="searchInput" placeholder="Search coupon codes..."
                            class="!bg-white/5 border border-white/10 rounded-full py-2.5 pl-12 pr-6 text-sm w-full focus:outline-none focus:border-primary text-white placeholder:text-slate-500 transition-all">
                    </div>

                    <div class="flex items-center gap-3">
                        <select class="bg-primary text-white text-xs font-bold px-4 py-2.5 rounded-lg border-none focus:ring-0 cursor-pointer outline-none appearance-none pr-8 relative">
                            <option value="active">Active</option>
                            <option value="expired">Expired</option>
                        </select>
                        <select class="bg-primary text-white text-xs font-bold px-4 py-2.5 rounded-lg border-none focus:ring-0 cursor-pointer outline-none appearance-none pr-8 relative">
                            <option value="expired">Expired</option>
                        </select>
                        <button onclick="openCouponModal()" class="flex items-center gap-2 bg-primary hover:bg-primary/90 text-white px-6 py-2.5 rounded-full font-bold text-xs tracking-wide transition-all shadow-[0_4px_20px_rgba(0,85,255,0.4)] ml-2">
                            <span class="material-symbols-outlined text-[16px]">add</span>
                            Create New Coupon
                        </button>
                    </div>
                </div>

                <!-- Table -->
                <div class="overflow-x-auto">
                    <table class="w-full text-left border-collapse">
                        <thead>
                            <tr class="border-b border-white/5 text-[10px] text-slate-500 font-bold uppercase tracking-widest">
                                <th class="px-8 py-5">Coupon Code</th>
                                <th class="px-6 py-5">Discount Type</th>
                                <th class="px-6 py-5">Value</th>
                                <th class="px-6 py-5">Status</th>
                                <th class="px-6 py-5">Expiry Date</th>
                                <th class="px-8 py-5 text-right">Actions</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-white/5 text-sm" id="couponsTableBody">
                            <% if (coupons && coupons.length > 0) { %>
                                <% coupons.forEach(coupon => { %>
                                    <tr class="hover:bg-white/5 transition-colors group">
                                        <td class="px-8 py-4">
                                            <div class="flex items-center gap-4">
                                                <div class="w-10 h-10 rounded-full flex items-center justify-center text-[10px] font-bold text-white/50
                                                    <%= new Date() > new Date(coupon.expirationDate) || !coupon.isActive ? 'bg-rose-500/20 text-rose-500' : 'bg-primary/20 text-primary' %>">
                                                    <%= coupon.code.substring(0,2) %>
                                                </div>
                                                <span class="font-bold text-white tracking-wide"><%= coupon.code %></span>
                                            </div>
                                        </td>
                                        <td class="px-6 py-4 text-slate-400 capitalize">
                                            <%= coupon.discountType === 'flat' ? 'Fixed Amount' : 'Percentage' %>
                                        </td>
                                        <td class="px-6 py-4 font-bold text-white">
                                            <%= coupon.discountType === 'flat' ? '₹' + coupon.discountValue : coupon.discountValue + '%' %>
                                        </td>
                                        <td class="px-6 py-4">
                                            <% if (new Date() > new Date(coupon.expirationDate) || !coupon.isActive) { %>
                                                <span class="px-3 py-1 text-[10px] font-bold uppercase tracking-widest rounded-full bg-rose-500/10 text-rose-500 border border-rose-500/20">Expired</span>
                                            <% } else { %>
                                                <span class="px-3 py-1 text-[10px] font-bold uppercase tracking-widest rounded-full bg-emerald-500/10 text-emerald-500 border border-emerald-500/20">Active</span>
                                            <% } %>
                                        </td>
                                        <td class="px-6 py-4 text-slate-400 text-sm">
                                            <%= new Date(coupon.expirationDate).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %>
                                        </td>
                                        <td class="px-8 py-4 flex items-center justify-end gap-4">
                                            <button onclick="editCoupon('<%= JSON.stringify(coupon) %>')" class="text-slate-500 hover:text-white transition-colors" title="Edit">
                                                <span class="material-symbols-outlined text-[18px]">edit</span>
                                            </button>
                                            <button onclick="toggleCouponStatus('<%= coupon._id %>')" class="text-slate-500 hover:text-white transition-colors" title="<%= coupon.isActive ? 'Deactivate' : 'Activate' %>">
                                                <span class="material-symbols-outlined text-[18px]"><%= coupon.isActive ? 'block' : 'check_circle' %></span>
                                            </button>
                                            <button onclick="deleteCoupon('<%= coupon._id %>')" class="text-rose-500/70 hover:text-rose-500 transition-colors" title="Delete">
                                                <span class="material-symbols-outlined text-[18px]">delete</span>
                                            </button>
                                        </td>
                                    </tr>
                                <% }) %>
                            <% } else { %>
                                <tr>
                                    <td colspan="6" class="px-8 py-12 text-center text-slate-500">
                                        No coupons found. Create one to get started!
                                    </td>
                                </tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>

                <!-- Footer Stats & Pagination -->
                <div class="p-6 border-t border-white/5 flex items-center justify-between">
                    <p class="text-[10px] text-slate-500 font-medium uppercase tracking-widest">
                        Showing <%= coupons ? coupons.length : 0 %> coupons
                    </p>
                    <div class="flex items-center gap-2">
                        <button class="px-4 py-2 rounded-lg border border-white/10 text-slate-400 hover:bg-white/5 transition-all text-[10px] font-bold uppercase">Previous</button>
                        <button class="h-8 w-8 flex items-center justify-center rounded-lg text-[10px] font-bold bg-primary text-white shadow-[0_0_15px_rgba(0,85,255,0.3)]">1</button>
                        <button class="px-4 py-2 rounded-lg border border-white/10 text-slate-400 hover:bg-white/5 transition-all text-[10px] font-bold uppercase">Next</button>
                    </div>
                </div>
            </section>
        </div>
    </main>

    <!-- Create / Edit Coupon Modal -->
    <div id="couponModal" class="fixed inset-0 z-50 hidden items-center justify-center p-4" style="background:rgba(0,0,0,0.7);backdrop-filter:blur(6px);">
        <div class="bg-[#0f1420] border border-white/10 rounded-2xl w-full max-w-lg shadow-2xl">
            <!-- Modal Header -->
            <div class="flex items-center justify-between px-8 py-6 border-b border-white/5">
                <div>
                    <h3 id="modalTitle" class="text-lg font-bold tracking-tight">Create New Coupon</h3>
                    <p class="text-[11px] text-slate-500 mt-0.5">Fill in the details below</p>
                </div>
                <button onclick="closeCouponModal()" class="text-slate-500 hover:text-white transition-colors">
                    <span class="material-symbols-outlined">close</span>
                </button>
            </div>

            <!-- Modal Body -->
            <form id="couponForm" class="p-8 space-y-5">
                <input type="hidden" id="couponId">

                <div class="grid grid-cols-2 gap-5">
                    <div class="col-span-2">
                        <label class="block text-[10px] font-bold text-slate-400 uppercase tracking-widest mb-2">Coupon Code</label>
                        <input type="text" id="couponCode" placeholder="e.g. SUMMER25"
                            class="w-full bg-white/5 border border-white/10 rounded-xl px-4 py-3 text-sm font-bold uppercase focus:outline-none focus:border-primary transition-all placeholder:normal-case placeholder:font-normal placeholder:text-slate-600">
                    </div>

                    <div>
                        <label class="block text-[10px] font-bold text-slate-400 uppercase tracking-widest mb-2">Discount Type</label>
                        <select id="discountType" onchange="updateValueLabel()"
                            class="w-full bg-white/5 border border-white/10 rounded-xl px-4 py-3 text-sm focus:outline-none focus:border-primary transition-all appearance-none">
                            <option value="percentage">Percentage (%)</option>
                            <option value="flat">Fixed Amount (₹)</option>
                        </select>
                    </div>

                    <div>
                        <label id="valueLabel" class="block text-[10px] font-bold text-slate-400 uppercase tracking-widest mb-2">Discount Value (%)</label>
                        <input type="number" id="discountValue" min="1" placeholder="e.g. 20"
                            class="w-full bg-white/5 border border-white/10 rounded-xl px-4 py-3 text-sm focus:outline-none focus:border-primary transition-all placeholder:text-slate-600">
                    </div>

                    <div>
                        <label class="block text-[10px] font-bold text-slate-400 uppercase tracking-widest mb-2">Min. Purchase (₹)</label>
                        <input type="number" id="minPurchaseAmount" min="0" placeholder="e.g. 500"
                            class="w-full bg-white/5 border border-white/10 rounded-xl px-4 py-3 text-sm focus:outline-none focus:border-primary transition-all placeholder:text-slate-600">
                    </div>

                    <div>
                        <label class="block text-[10px] font-bold text-slate-400 uppercase tracking-widest mb-2">Max Discount (₹)</label>
                        <input type="number" id="maxDiscountAmount" min="0" placeholder="Optional cap"
                            class="w-full bg-white/5 border border-white/10 rounded-xl px-4 py-3 text-sm focus:outline-none focus:border-primary transition-all placeholder:text-slate-600">
                    </div>

                    <div class="col-span-2">
                        <label class="block text-[10px] font-bold text-slate-400 uppercase tracking-widest mb-2">Expiration Date</label>
                        <input type="date" id="expirationDate"
                            class="w-full bg-white/5 border border-white/10 rounded-xl px-4 py-3 text-sm focus:outline-none focus:border-primary transition-all">
                    </div>
                </div>

                <!-- Modal Footer -->
                <div class="flex justify-end gap-3 pt-2">
                    <button type="button" onclick="closeCouponModal()" class="px-6 py-2.5 rounded-xl border border-white/10 text-sm text-slate-400 hover:bg-white/5 transition-all font-bold">Cancel</button>
                    <button type="button" onclick="submitCoupon()" class="px-8 py-2.5 rounded-xl bg-primary hover:bg-primary/90 text-sm text-white font-bold shadow-[0_4px_20px_rgba(0,85,255,0.35)] transition-all">Save Coupon</button>
                </div>
            </form>
        </div>
    </div>

    <script>
        // --- Modal Helpers ---
        function openCouponModal() {
            document.getElementById('modalTitle').textContent = 'Create New Coupon';
            document.getElementById('couponForm').reset();
            document.getElementById('couponId').value = '';
            document.getElementById('valueLabel').textContent = 'Discount Value (%)';
            document.getElementById('couponModal').classList.remove('hidden');
            document.getElementById('couponModal').classList.add('flex');
        }

        function closeCouponModal() {
            document.getElementById('couponModal').classList.add('hidden');
            document.getElementById('couponModal').classList.remove('flex');
        }

        function updateValueLabel() {
            const type = document.getElementById('discountType').value;
            document.getElementById('valueLabel').textContent =
                type === 'percentage' ? 'Discount Value (%)' : 'Discount Value (\u20b9)';
        }

        function editCoupon(couponJson) {
            const coupon = JSON.parse(couponJson);
            document.getElementById('modalTitle').textContent = 'Edit Coupon';
            document.getElementById('couponId').value = coupon._id;
            document.getElementById('couponCode').value = coupon.code;
            document.getElementById('discountType').value = coupon.discountType;
            document.getElementById('discountValue').value = coupon.discountValue;
            document.getElementById('minPurchaseAmount').value = coupon.minPurchaseAmount || '';
            document.getElementById('maxDiscountAmount').value = coupon.maxDiscountAmount || '';
            const expDate = coupon.expirationDate ? coupon.expirationDate.split('T')[0] : '';
            document.getElementById('expirationDate').value = expDate;
            updateValueLabel();
            document.getElementById('couponModal').classList.remove('hidden');
            document.getElementById('couponModal').classList.add('flex');
        }

        // --- Submit (Create or Update) ---
        async function submitCoupon() {
            const id = document.getElementById('couponId').value;
            const code = document.getElementById('couponCode').value.trim().toUpperCase();
            const discountType = document.getElementById('discountType').value;
            const discountValue = parseFloat(document.getElementById('discountValue').value);
            const minPurchaseAmount = parseFloat(document.getElementById('minPurchaseAmount').value) || 0;
            const maxDiscountAmount = parseFloat(document.getElementById('maxDiscountAmount').value) || null;
            const expirationDate = document.getElementById('expirationDate').value;

            if (!code || !discountValue || !expirationDate) {
                return Swal.fire({ icon: 'warning', title: 'Missing Fields', text: 'Code, Value and Expiry Date are required.', background: '#0f1420', color: '#fff' });
            }

            const url = id ? `/admin/coupons/update/${id}` : '/admin/coupons/create';
            const method = 'POST';

            try {
                const res = await fetch(url, {
                    method,
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ code, discountType, discountValue, minPurchaseAmount, maxDiscountAmount, expirationDate })
                });
                const data = await res.json();
                if (data.success) {
                    Swal.fire({ icon: 'success', title: id ? 'Updated!' : 'Created!', text: data.message, background: '#0f1420', color: '#fff', timer: 1500, showConfirmButton: false })
                        .then(() => location.reload());
                } else {
                    Swal.fire({ icon: 'error', title: 'Error', text: data.message, background: '#0f1420', color: '#fff' });
                }
            } catch (err) {
                Swal.fire({ icon: 'error', title: 'Error', text: 'Something went wrong.', background: '#0f1420', color: '#fff' });
            }
        }

        // --- Toggle Status ---
        async function toggleCouponStatus(id) {
            try {
                const res = await fetch(`/admin/coupons/toggle/${id}`, { method: 'POST' });
                const data = await res.json();
                if (data.success) location.reload();
                else Swal.fire({ icon: 'error', title: 'Error', text: data.message, background: '#0f1420', color: '#fff' });
            } catch (err) {
                Swal.fire({ icon: 'error', title: 'Error', text: 'Something went wrong.', background: '#0f1420', color: '#fff' });
            }
        }

        // --- Delete ---
        async function deleteCoupon(id) {
            const confirm = await Swal.fire({
                icon: 'warning', title: 'Delete Coupon?',
                text: 'This action cannot be undone.',
                showCancelButton: true, confirmButtonText: 'Yes, Delete',
                confirmButtonColor: '#ef4444', background: '#0f1420', color: '#fff'
            });
            if (!confirm.isConfirmed) return;
            try {
                const res = await fetch(`/admin/coupons/delete/${id}`, { method: 'DELETE' });
                const data = await res.json();
                if (data.success) location.reload();
                else Swal.fire({ icon: 'error', title: 'Error', text: data.message, background: '#0f1420', color: '#fff' });
            } catch (err) {
                Swal.fire({ icon: 'error', title: 'Error', text: 'Something went wrong.', background: '#0f1420', color: '#fff' });
            }
        }

        // --- Live Search ---
        document.getElementById('searchInput').addEventListener('input', function () {
            const val = this.value.toLowerCase();
            document.querySelectorAll('#couponsTableBody tr').forEach(row => {
                row.style.display = row.textContent.toLowerCase().includes(val) ? '' : 'none';
            });
        });

        // Close modal on backdrop click
        document.getElementById('couponModal').addEventListener('click', function(e) {
            if (e.target === this) closeCouponModal();
        });
    </script>
</body>
</html>
